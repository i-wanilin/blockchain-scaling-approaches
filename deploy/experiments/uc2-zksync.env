# UC2 on zksync: the frozen six-player match (deploy/cluster run uc2-zksync --reps 3)
USE_CASE=uc2
# the frozen match (spec §7.3 Run parameters, plan Global Constraints): 6 players, 20 Hz, 1 200 ticks (60 s),
# seed 42, mesh; 10 000 points per player (the bound is checked by every run's setup, arena.bound)
N_PLAYERS=6
TICKRATE=20
GAME_TICKS=1200
GAME_SEED=42
START_POINTS=10000
# player 0 = bath1 (also the time server and, on Perun, the hub), then bath2, bath7, bath4, bath5, bath6
PLAYERS=(bath1 bath2 bath7 bath4 bath5 bath6)
# R9: bath3 takes no part in UC2: no code check, no facts, no recorder; pre-flight expects the other 7
IDLE_BOARDS="bath3"
# MIXED WI-FI (owner, 2026-10-05/06): bath1 and bath2 on the router's 5 GHz radio, every other board on
# 2.4 GHz; pre-flight checks each board's radio
WIFI_5GHZ_BOARDS="bath1 bath2"
# the payment client's queue and drain, as UC1
MAX_QUEUE=10000
DRAIN_S=60
# L1 funds per account (untimed setup); DEPOSIT_WEI = the ETH each player bridges as Open on the rollups
# (Perun: the player's channel holds its points, the payment client gets --deposit-wei 0)
FUND_WEI=2000000000000000000
DEPOSIT_WEI=1000000000000000000
STACK=zksync
# zkSync mainnet's per-account limit (cluster spec §7.3)
MAX_IN_FLIGHT=20
# as UC1 zkSync: no slot is freed before an outcome; Close waits behind the backlog
RECEIPT_TIMEOUT_S=1200
CLOSE_TIMEOUT_S=1800
ZK_COMMIT_DEADLINE_MS=20000
# cooling-gate cap as UC1 zkSync (a cap, not a wait)
COOL_MAX_S=2700
# fee cap 10 x base fee: measure/arbitrum.py FEE_CAP_MULTIPLIER (shared by measure/zksync.py; code, not a key)
