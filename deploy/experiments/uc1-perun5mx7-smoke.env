USE_CASE=uc1
STACK=perun
WINDOW_MS=10
# smoke (owner, 2026-10-11): does bath7 keep up as customer 5 at the heaviest window? 3 min instead of 15
DURATION_S=180
PRICE_WEI=1000000000000
DEPOSIT_WEI=1000000000000000000
FUND_WEI=2000000000000000000
MAX_IN_FLIGHT=64
MAX_QUEUE=10000
DRAIN_S=60
# FINAL UC1 board set (owner, 2026-10-11): bath3 is dead (board power fault), bath7 takes its place as customer 5;
# the same boards as the UC2 series. bath3 idle (not synced, not checked).
CUSTOMERS=(bath2 bath4 bath5 bath6 bath7)
IDLE_BOARDS="bath3"
EXPECTED_CUSTOMERS=5
# channel update timeout (s): an update not answered in time is unresolved and breaks the channel (Q6: no retries)
UPDATE_TIMEOUT_S=10
# channel challenge duration (s) for the sensor node; must stay 10: the customer sidecar uses its default
# (challengeDuration = 10, perun/hub-demo/setup.go; payclient passes none), and the sensor refuses any other
CHALLENGE_S=10
# Q4 A: channel state persisted (LevelDB) on the sensor and the customers
PERSIST=1
# Q7 A: strict payment policy on the sensor (the customer may only lower its own balance)
STRICT_POLICY=1
# sensor tolerates stalls up to 30 s (3600 frames at 120 rows/s), as in the zkSync5/Arbitrum5 runs (R-P2)
SENSOR_QUEUE_MAX=3600
SENSOR_WRITE_TIMEOUT_S=30
# MIXED WI-FI series (owner, 2026-10-05): bath1 (sensor) and bath2 on the router's 5 GHz radio, every other board
# on 2.4 GHz (bath0's 5 GHz link measured 13 Mbit/s); spec §9 U4. Pre-flight checks each board's radio.
WIFI_5GHZ_BOARDS="bath1 bath2"
