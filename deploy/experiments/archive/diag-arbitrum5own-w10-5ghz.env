# ARCHIVED (superseded): Wi-Fi diagnostic (2026-10-04..05), not thesis data, customers bath2..bath6 (bath3 included); its finding became the mixed Wi-Fi setup (bath1, bath2 on 5 GHz) of the final uc1-*5mx7-* series — see results/pi/README.md
USE_CASE=uc1
STACK=arbitrum
WINDOW_MS=10
DURATION_S=900
PRICE_WEI=1000000000000
DEPOSIT_WEI=1000000000000000000
FUND_WEI=2000000000000000000
MAX_IN_FLIGHT=64
MAX_QUEUE=10000
DRAIN_S=60
# 5 customers (owner, 2026-10-02), the same setup as the zkSync series uc1-zksync5-*: bath7 left out
CUSTOMERS=(bath2 bath3 bath4 bath5 bath6)
EXPECTED_CUSTOMERS=5
# sensor tolerates stalls up to 30 s (3600 frames at 120 rows/s), as in the zkSync runs
SENSOR_QUEUE_MAX=3600
SENSOR_WRITE_TIMEOUT_S=30
# own receipts (task: Arbitrum at the 10 ms window overloads the shared Wi-Fi when every client
# downloads every block's receipts; own = per-account receipts only, same detection moment)
RECEIPT_MODE=own
# DIAGNOSTIC 2026-10-04 (not thesis data): bath0, bath1, bath2 on the router's 5 GHz radio
WIFI_5GHZ_BOARDS="bath0 bath1 bath2"
