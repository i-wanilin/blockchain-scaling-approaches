# gather_facts DIR — DIR/<host>.json from board-facts.sh (piped in, no copy on the board);
# a board that fails leaves no file, which pre-flight reports as unreachable.
gather_facts() {
  local d=$1 h; mkdir -p "$d"
  for h in "${BOARDS[@]}"; do
    # shellcheck disable=SC2015  # rm only when the facts could not be read
    ( timeout 30 ssh "${SSH_OPTS[@]}" "$h" 'bash -s' < "$REPO/deploy/board-facts.sh" > "$d/$h.json" 2>/dev/null \
        && [ -s "$d/$h.json" ] || rm -f "$d/$h.json" ) &
  done
  wait
}

# gather_clock DIR — raw `chronyc tracking` per board (the offset is also in the facts).
gather_clock() {
  local d=$1 h; mkdir -p "$d"
  for h in "${BOARDS[@]}"; do (T=20 on "$h" 'date +%s.%N; chronyc tracking' > "$d/$h.txt" 2>&1 || true) & done
  wait
}

cmd_status() {
