PERUN_CONTRACTS="$PERUN_DIST/perun-contracts.json"
# shellcheck disable=SC2088  # the tilde is expanded on the board, not here
PERUN_BIN_REMOTE='~/measure-code/bin/perun-node'
PERUN_CONTROL_PORT=8090; PERUN_WIRE_PORT=9000               # sensor control HTTP on bath1; Perun wire on the sensor and every customer
# Gas measured in Task 1 (customer side): open 45 801 (one deposit), close conclude ~170 900 + withdraw ~42 800.
PERUN_OPEN_GAS=45801; PERUN_CLOSE_GAS=213700
PERUN_TERM_GRACE_S=${PERUN_TERM_GRACE_S:-90}  # finish_run: a payclient's quiesce + close + sidecar stop takes up to ~45 s
SETTLE_WAIT_S=${SETTLE_WAIT_S:-600}          # after the payment clients completed: the sensor node settles and exits
ARB_VOLUMES=(config seqdata l1data l1keystore tokenbridge-data)   # bath0:~/arbitrum/<v>.tgz -> volume arbitrum_<v>
GESL_SIG=${GESL_SIG:-6063}                 # decided 2026-09-30: most complete and the only 15-minute recording
RPC_WAIT_S=${RPC_WAIT_S:-300}; READY_WAIT_S=${READY_WAIT_S:-300}; SENSOR_WAIT_S=${SENSOR_WAIT_S:-180}
COMPLETE_EXTRA_S=${COMPLETE_EXTRA_S:-400}   # Arbitrum: Close's 300 s receipt wait + payclient's 30 s admission
                                           # wait + 30 s post-Close settle + RPC retries (fix-close-nonce)
CLOSE_MARGIN_S=${CLOSE_MARGIN_S:-300}      # time around Close besides its receipt wait (reads, send, write-out)
# complete_extra_s — the wait after DURATION_S + DRAIN_S for the payment clients to finish: COMPLETE_EXTRA_S,
# raised to CLOSE_TIMEOUT_S + CLOSE_MARGIN_S when the env sets a Close timeout (zkSync: 1800 s), so that
# timeout is reachable (CLOSE_MARGIN_S also covers the two 30 s waits around Close). Arbitrum envs set no
# CLOSE_TIMEOUT_S: COMPLETE_EXTRA_S = 400 s.
complete_extra_s() {
  local x=$COMPLETE_EXTRA_S
  if [ -n "${CLOSE_TIMEOUT_S:-}" ] && [ $((CLOSE_TIMEOUT_S + CLOSE_MARGIN_S)) -gt "$x" ]; then
    x=$((CLOSE_TIMEOUT_S + CLOSE_MARGIN_S))
  fi
  echo "$x"
}
# Safe kill pattern: the bracket keeps it from matching the command line that carries it.
# perun-node by its full deployed path as argv[0] (PERUN_BIN_REMOTE, the tilde expanded on the board) and its
# UC1 mode, never as a substring (final review T7-5): an editor, a log or a probe binary elsewhere is not it.
# UC2 adds the hub and the player sidecar (uc2-hub, uc2-player) and the game node (arena.node).
PERUN_PROC='^/[^ ]*/measure-code/bin/[p]erun-node -mode uc(1-(customer|sensor)|2-(hub|player))( |$)'
PERUN_SENSOR_PROC='^/[^ ]*/measure-code/bin/[p]erun-node -mode uc1-sensor( |$)'
PERUN_HUB_PROC='^/[^ ]*/measure-code/bin/[p]erun-node -mode uc2-hub( |$)'
LEFTOVERS="[m]easure\\.(payclient|sensor|customer)|[a]rena\\.node|[r]ecorder\\.sh|[z]k-sampler\\.sh|$PERUN_PROC"
SSH_OPTS=(-o ConnectTimeout=8 -o BatchMode=yes -o ServerAliveInterval=10 -o ServerAliveCountMax=3)

# on_once HOST CMD — one ssh attempt, killed after T seconds (default 60).
on_once() { local h=$1; shift; timeout "${T:-60}" ssh -n "${SSH_OPTS[@]}" "$h" "$@"; }
# retry_255 LABEL CMD... — run CMD; only when it exits 255 (ssh/scp's own connection error, never a remote
# command's exit status) try again: 3 attempts in all, 2 s and 5 s apart, each retry logged to stderr.
RETRY_BACKOFF=(2 5)
retry_255() {
  local label=$1 a=0 rc; shift
  while :; do
    rc=0; "$@" || rc=$?
    [ "$rc" -eq 255 ] && [ "$a" -lt "${#RETRY_BACKOFF[@]}" ] || return "$rc"
    echo "ssh: connection to $label failed (exit 255), retry $((a + 1))/${#RETRY_BACKOFF[@]} in ${RETRY_BACKOFF[a]} s" >&2
    sleep "${RETRY_BACKOFF[a]}"; a=$((a + 1))
  done
}
# on HOST CMD — run CMD on HOST, killed after T seconds (default 60); retried on connection errors only.
# Safe for read-only and idempotent commands. Launching commands go through bg, which does not use this.
on() { retry_255 "$1" on_once "$@"; }
# scp_try SECONDS SCP_ARGS... — scp with the same timeout wrapper and 255-retry (the host for the log is taken from the HOST:PATH argument).
scp_try() {
  local t=$1 a host=scp; shift
  for a in "$@"; do case $a in *:*) host=${a%%:*}; break ;; esac; done
  retry_255 "$host" timeout "$t" scp "${SSH_OPTS[@]}" "$@"
}
# bg HOST LOG CMD — start CMD detached on HOST in ~/measure-code, stdout+stderr to LOG.
# The `cd || exit` must not be joined with && to the background job: `a && b &` backgrounds
# the whole list in a subshell that keeps ssh's stdout open, so ssh would not return.
# launch_guarded HOST PGREP_PATTERN REMOTE_CMD — start a detached job over ssh, safely against 255.
# Not idempotent by itself, so it must not be retried blindly: ssh may exit 255 after the remote shell
# already started the job. Before every retry it asks the board (pgrep with a bracketed, self-safe
# pattern) whether the job runs, and launches again only if it does not.
launch_guarded() {
  local h=$1 pat=$2 cmd=$3 a=0 rc
  while :; do
    rc=0; on_once "$h" "$cmd" || rc=$?
    [ "$rc" -eq 255 ] || return "$rc"
    while :; do            # ssh failed: never relaunch before knowing whether the first launch got through
      [ "$a" -lt "${#RETRY_BACKOFF[@]}" ] || return 255
      echo "ssh: connection to $h failed (exit 255) launching $pat, retry $((a + 1))/${#RETRY_BACKOFF[@]} in ${RETRY_BACKOFF[a]} s" >&2
      sleep "${RETRY_BACKOFF[a]}"; a=$((a + 1))
      rc=0; T=20 on_once "$h" "pgrep -f '$pat' > /dev/null" || rc=$?
      if [ "$rc" -eq 0 ]; then echo "$pat already running on $h, not launching again" >&2; return 0; fi
      [ "$rc" -eq 1 ] && break         # pgrep says: not running, launch again
    done                               # 255 (or timeout): board still unreachable, ask again
  done
}
# bg HOST LOG CMD — start CMD detached on HOST in ~/measure-code, stdout+stderr to LOG.
# The `cd || exit` must not be joined with && to the background job: `a && b &` backgrounds
# the whole list in a subshell that keeps ssh's stdout open, so ssh would not return.
# The already-running check is on the module name from `-m measure.<module>`.
bg() {
  local h=$1 log=$2 mod; shift 2
  mod=$(sed -n 's/.*-m measure\.\([a-z_]*\).*/\1/p' <<< "$*")
  [ -n "$mod" ] || die "bg: no '-m measure.<module>' in the command"
  launch_guarded "$h" "[m]easure\\.$mod " "cd ~/measure-code || exit 1; setsid nohup $* > $log 2>&1 < /dev/null &"
}
rpc_ok() { curl -s -m 3 -X POST -H 'content-type: application/json' \
  --data '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}' "$1" | grep -q '"result"'; }
tcp_ok() { timeout 3 bash -c "</dev/tcp/$1/$2" 2>/dev/null; }
say() { echo "[$(date +%H:%M:%S)] $*"; }
FAIL_REASON=""
die() { FAIL_REASON="$*"; echo "ERROR: $*" >&2; exit 1; }
code_hash() { (cd "$1" && find measure -name '*.py' -not -path '*/__pycache__/*' | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-16); }
# R8: the UC2 game code hash (tank-arena/arena and tank-arena/net, shipped by sync), checked on every board
# like code_hash. The same command runs here and, in ~/measure-code, on the boards.
GAME_HASH_CMD="find tank-arena/arena tank-arena/net -name '*.py' -not -path '*/__pycache__/*' | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-16"
game_hash() { (cd "$1" && bash -o pipefail -c "$GAME_HASH_CMD"); }

# apply_idle — R9: BOARDS = ALL_BOARDS minus IDLE_BOARDS (space-separated), in their order. bath0 (the stack)
# and bath1 (the time server) can never be idle; an unknown name is refused. `run` takes IDLE_BOARDS from the
# experiment file only (one_run); every other command from the environment (default bath3; IDLE_BOARDS= for all).
apply_idle() {
  local h keep=()
  for h in ${IDLE_BOARDS:-}; do
    case " ${ALL_BOARDS[*]} " in *" $h "*) ;; *) die "IDLE_BOARDS: unknown board '$h'" ;; esac
    [ "$h" != bath0 ] && [ "$h" != bath1 ] || die "IDLE_BOARDS: $h cannot be idle (bath0 runs the stack, bath1 is the time server)"
  done
  for h in "${ALL_BOARDS[@]}"; do
    case " ${IDLE_BOARDS:-} " in *" $h "*) ;; *) keep+=("$h") ;; esac
  done
  BOARDS=("${keep[@]}")
}

# run_start_commit OUT — OUT/run-start-commit.txt: the workstation's HEAD when the run starts, followed by
# " dirty" if source outside results/ is changed. The manifest (written at the end) prefers it over HEAD then.
run_start_commit() {
  local c; c=$(git -C "$REPO" rev-parse HEAD) || die "git rev-parse HEAD failed in $REPO"
  if [ -n "$(git -C "$REPO" status --porcelain -- . ':!results')" ]; then c="$c dirty"; fi
  echo "$c" > "$1/run-start-commit.txt"
}

# gesl_check OUT — the CSV on the sensor board must be recording GESL_SIG exactly (measure.gesl.KNOWN_SHA256);
# the run fails otherwise. Writes OUT/gesl.json {sig, sha256, file} for the manifest.
gesl_check() {
  local want got f="sigId-$GESL_SIG-PMU.csv"
  want=$(cd "$REPO" && "$LPY" -c 'import sys; from measure.gesl import KNOWN_SHA256 as K; print(K.get(int(sys.argv[1]), ""))' \
    "$GESL_SIG" 2>/dev/null) || true
  [ -n "$want" ] || die "GESL_SIG=$GESL_SIG has no SHA-256 in measure.gesl.KNOWN_SHA256"
  got=$(T=120 on "$SENSOR_BOARD" "sha256sum ~/gesl/$f" | cut -d' ' -f1) || true
  [ "$got" = "$want" ] || die "GESL CSV on $SENSOR_BOARD is not recording $GESL_SIG (sha256 ${got:-unreadable}, want $want); run deploy/cluster sync"
  printf '{"sig": %s, "sha256": "%s", "file": "%s"}\n' "$GESL_SIG" "$got" "$f" > "$1/gesl.json"
}

# stack_config OUT [STACK] — best effort, read only: SHA-256 of bath0's compose file, of the snapshot's SHA256SUMS
# (the tarballs are checked against it by `up`) and of the nitro config inside config.tgz, which `up` has
# just restored into the config volume. Written as sha256sum lines to OUT/stack-config.sha256.
# zkSync: the compose file, the snapshot's SHA256SUMS, the general.yaml `up` wrote (one changed line, Q2)
# and the server binary.
stack_config() {
  local cmd='set -o pipefail; cd ~/arbitrum && sha256sum docker-compose.yaml SHA256SUMS &&
    tar xzOf config.tgz ./sequencer_config.json | sha256sum | sed "s|-\$|config.tgz:sequencer_config.json|"'
  [ "${2:-arbitrum}" != zksync ] || cmd="sha256sum $ZK_COMPOSE/docker-compose.yml $ZK_SNAP/SHA256SUMS $ZK_CHAIN/configs/general.yaml $ZK_BIN"
  [ "${2:-arbitrum}" != perun ] || cmd="sha256sum $ANVIL_BIN"     # Perun: nothing configured besides Anvil's command line
  T=60 on bath0 "$cmd" > "$1/stack-config.sha256" 2>/dev/null \
    || { rm -f "$1/stack-config.sha256"; echo "warning: could not hash the stack configuration on bath0" >&2; }
}

# build_perun — cross-compile perun-node from the committed perun/ tree (plan, Global Constraints: binary
# provenance): arm64 for the boards, amd64 for `up perun`'s deploy step. Refuses a dirty perun/ tree. The hash
# depends on the Go toolchain, so the toolchain is recorded next to it (perun-node.build).
perun_tree() { git -C "$REPO" rev-parse HEAD:perun; }
build_perun() {
  [ -z "$(git -C "$REPO" status --porcelain -- perun)" ] \
    || die "perun/ has uncommitted changes; commit them first (the perun-node binary must match a commit)"
  local arch
  for arch in arm64 amd64; do
    mkdir -p "$PERUN_DIST/$arch"
    (cd "$REPO/perun/hub-demo" && CGO_ENABLED=0 GOOS=linux GOARCH=$arch \
      go build -trimpath -buildvcs=false -ldflags "-s -w" -o "$PERUN_DIST/$arch/perun-node.tmp" .) \
      || die "go build perun-node ($arch) failed"
    mv "$PERUN_DIST/$arch/perun-node.tmp" "$PERUN_DIST/$arch/perun-node"
  done
  sha256sum "$PERUN_DIST/arm64/perun-node" | cut -d' ' -f1 > "$PERUN_DIST/arm64/perun-node.sha256"
  { echo "sha256 $(cat "$PERUN_DIST/arm64/perun-node.sha256")"
    echo "toolchain $(go version)"
    echo "binary_toolchain $(go version "$PERUN_DIST/arm64/perun-node" | awk '{print $NF}')"   # embedded in the binary
    echo "perun_tree $(perun_tree)"
    echo "commit $(git -C "$REPO" rev-parse HEAD)"
    echo "flags CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -buildvcs=false -ldflags \"-s -w\""
    echo "built $(date -u +%Y-%m-%dT%H:%M:%SZ)"; } > "$PERUN_DIST/arm64/perun-node.build"
  echo "perun-node built: $(cat "$PERUN_DIST/arm64/perun-node.sha256") ($(go version | cut -d' ' -f3))"
}

cmd_sync() {
  build_perun
  local tmp; tmp=$(mktemp -d)
  unzip -o -q "$REPO/data/gesl-samples/sigId-$GESL_SIG.zip" "sigId-$GESL_SIG-PMU.csv" -d "$tmp"
  local h pids=() failed="" psha gh; psha=$(cat "$PERUN_DIST/arm64/perun-node.sha256")
  gh=$(game_hash "$REPO") || die "game hash of $REPO/tank-arena failed"
  [ -n "$gh" ] || die "game hash of $REPO/tank-arena is empty"
  [ -z "${IDLE_BOARDS:-}" ] || echo "IDLE_BOARDS: not syncing ${IDLE_BOARDS}"
  for h in "${BOARDS[@]:1}"; do
    (
      # measure/, the recorder, and the UC2 game (tank-arena/arena, tank-arena/net: R8, checked below)
      tar -C "$REPO" --exclude=__pycache__ -czf - measure deploy/recorder.sh deploy/board-facts.sh \
          tank-arena/arena tank-arena/net \
        | timeout 120 ssh "${SSH_OPTS[@]}" "$h" 'rm -rf ~/measure-code && mkdir -p ~/measure-code && tar -xzf - -C ~/measure-code'
      s=$(T=60 on "$h" "cd ~/measure-code && $GAME_HASH_CMD")
      [ "$s" = "$gh" ] || { echo "game hash ${s:-missing} differs from the workstation ($gh) after the copy" >&2; exit 1; }
      # perun-node (arm64) to every board; checked against sync's hash after the copy
      timeout 300 ssh "${SSH_OPTS[@]}" "$h" 'mkdir -p ~/measure-code/bin && cat > ~/measure-code/bin/perun-node.tmp' \
        < "$PERUN_DIST/arm64/perun-node"
      T=60 on "$h" "set -e; cd ~/measure-code/bin; chmod 755 perun-node.tmp; mv perun-node.tmp perun-node
        [ \"\$(sha256sum perun-node | cut -d' ' -f1)\" = $psha ] || { echo 'perun-node hash differs after the copy' >&2; exit 1; }"
      T=1800 on "$h" 'set -e
        if [ ! -x ~/venv/bin/python ]; then
          sudo -n apt-get install -y -qq python3-venv >/dev/null 2>&1 \
            || { sudo -n apt-get update -qq >/dev/null && sudo -n apt-get install -y -qq python3-venv >/dev/null; }
          python3 -m venv ~/venv
        fi
        ~/venv/bin/pip install -q --disable-pip-version-check -r ~/measure-code/measure/requirements.txt'
    ) > "$tmp/$h.log" 2>&1 &
    pids+=("$h:$!")
  done
  local p
  for p in "${pids[@]}"; do
    wait "${p#*:}" || { failed="$failed ${p%%:*}"; sed "s/^/  ${p%%:*}: /" "$tmp/${p%%:*}.log" >&2; }
  done
  # The GESL data goes to bath1:~/gesl only, nowhere else.
  T=120 on "$SENSOR_BOARD" 'mkdir -p ~/gesl'
  timeout 300 scp -q "${SSH_OPTS[@]}" "$tmp/sigId-$GESL_SIG-PMU.csv" "$SENSOR_BOARD:gesl/"
  local want got
  want=$(sha256sum "$tmp/sigId-$GESL_SIG-PMU.csv" | cut -d' ' -f1)
  got=$(T=120 on "$SENSOR_BOARD" "sha256sum ~/gesl/sigId-$GESL_SIG-PMU.csv" | cut -d' ' -f1)
  rm -rf "$tmp"
  [ "$want" = "$got" ] || die "GESL CSV on $SENSOR_BOARD does not match (sha256 $got, want $want)"
  [ -z "$failed" ] || die "sync failed on:$failed"
  echo "synced ${BOARDS[*]:1} (code $(code_hash "$REPO"), game $gh, perun-node $psha)"
}

# one_stack STACK — refuse to bring STACK up while another stack runs on bath0 (three stacks: Arbitrum's
# arbitrum-* containers, zkSync's server and thesis_local-* containers, Perun's Anvil). One ssh call.
one_stack() {
  local seen other
  seen=$(T=30 on bath0 "pgrep -f '$ZK_PAT' >/dev/null && echo zksync_server; docker ps --format '{{.Names}}'; pgrep -x anvil >/dev/null && echo anvil; true") \
    || die "could not read bath0's processes and containers"
  case "$1" in
    arbitrum) other=$(grep -E "^(zksync_server|${ZK_PROJECT}-.*|anvil)\$" <<< "$seen" || true) ;;
    zksync)   other=$(grep -E '^(arbitrum-.*|anvil)$' <<< "$seen" || true) ;;
    perun)    other=$(grep -vx anvil <<< "$seen" || true) ;;   # any container at all, or the zkSync server
  esac
  [ -z "$other" ] || die "refusing 'up $1': another stack is running on bath0: $(tr '\n' ' ' <<< "$other")(run deploy/cluster down first)"
}

cmd_up() {
  case "${1:-}" in
    arbitrum) ;;
    zksync) stack_endpoints zksync; one_stack zksync; up_zksync; return ;;
    perun)  stack_endpoints perun; one_stack perun; up_perun; return ;;
    *) echo "usage: $0 up arbitrum|zksync|perun" >&2; exit 2 ;;
  esac
  stack_endpoints arbitrum; one_stack arbitrum
  local vols="${ARB_VOLUMES[*]}"
  # Restore the snapshot: verify the tarballs, recreate each volume, unpack into it.
  T=900 on bath0 "set -eo pipefail; cd ~/arbitrum
    for v in $vols; do [ -f \$v.tgz ] || { echo \"missing ~/arbitrum/\$v.tgz\" >&2; exit 1; }; done
    grep '\.tgz\$' SHA256SUMS | sha256sum -c --quiet
    docker compose down >/dev/null 2>&1 || true
    for v in $vols; do
      docker volume rm -f arbitrum_\$v >/dev/null
      docker volume create arbitrum_\$v >/dev/null
      docker run --rm -v arbitrum_\$v:/v -v \$HOME/arbitrum:/in:ro alpine tar xzf /in/\$v.tgz -C /v
    done
    docker compose up -d --quiet-pull 2>&1 | tail -n 5
    other=\$(docker ps --format '{{.Names}}' | grep -v '^arbitrum-' || true)
    [ -z \"\$other\" ] || { echo \"other containers running on bath0: \$other\" >&2; exit 1; }" \
    || die "snapshot restore / compose up failed on bath0"
  local deadline=$((SECONDS + RPC_WAIT_S))
  until rpc_ok "$L1" && rpc_ok "$L2_HTTP" && tcp_ok "$STACK_IP" 8548; do
    [ "$SECONDS" -lt "$deadline" ] || die "RPCs not up after ${RPC_WAIT_S}s (L1 $L1: $(rpc_ok "$L1" && echo ok || echo no), L2 $L2_HTTP: $(rpc_ok "$L2_HTTP" && echo ok || echo no), L2 WS :8548: $(tcp_ok "$STACK_IP" 8548 && echo ok || echo no))"
    sleep 2
  done
  echo "arbitrum up (snapshot restored)"
}

# up_zksync — restore the zkSync snapshot on bath0 (chain dir with RocksDB and configs, reth's data volume,
# PostgreSQL's raw volume: Q6 a), set the one config line of Q2, start reth + postgres and the native server
# (F2 command line), then wait until L1, L2 HTTP/WS and the server's health endpoint answer.
up_zksync() {
  local deadline_ms=${ZK_COMMIT_DEADLINE_MS:?set ZK_COMMIT_DEADLINE_MS (the experiment env, Q2)}
  [[ $deadline_ms =~ ^[1-9][0-9]*$ ]] || die "ZK_COMMIT_DEADLINE_MS='$deadline_ms' is not a positive integer"
  local t0=$SECONDS C="$ZK_CHAIN/configs"
  T=900 on bath0 "set -eo pipefail
    cd $ZK_SNAP
    [ \$(grep -cE ' (chain|reth-data|postgres-vol)\.tgz\$' SHA256SUMS) = 3 ] || { echo 'SHA256SUMS lacks chain/reth-data/postgres-vol' >&2; exit 1; }
    grep -E ' (chain|reth-data|postgres-vol)\.tgz\$' SHA256SUMS | sha256sum -c --quiet
    echo '$ZK_ERA_ARTIFACTS_SHA  era-artifacts.tgz' | sha256sum -c --quiet
    $ZK_STOP
    (cd $ZK_COMPOSE && docker compose down >/dev/null 2>&1 || true)
    # chain directory: RocksDB, configs (absolute paths in the tarball). The compose file in it is the
    # pre-Q7 one (reth on 127.0.0.1, CORS *), so it is never unpacked.
    rm -rf $ZK_CHAIN/db $ZK_CHAIN/artifacts
    tar xzf chain.tgz -C / --exclude='home/i_wanilin/zksync-ecosystem/thesis_local/docker-compose.yml'
    # build outputs the server reads at run time (spec §4): compared, unpacked again only if they differ
    (cd $ZK_CWD && tar dzf $ZK_SNAP/era-artifacts.tgz >/dev/null 2>&1) \
      || { echo 'era-artifacts differ from the snapshot: unpacking again'; tar xzf $ZK_SNAP/era-artifacts.tgz -C $ZK_CWD; }
    for v in reth-data postgres-data; do docker volume rm -f ${ZK_PROJECT}_\$v >/dev/null; docker volume create ${ZK_PROJECT}_\$v >/dev/null; done
    docker run --rm -v ${ZK_PROJECT}_reth-data:/v -v $ZK_SNAP:/in:ro alpine tar xzf /in/reth-data.tgz -C /v
    docker run --rm -v ${ZK_PROJECT}_postgres-data:/v -v $ZK_SNAP:/in:ro alpine tar xzf /in/postgres-vol.tgz -C /v
    # config: the snapshot's general.yaml with exactly one change (Q2), recorded
    cfg=$C/general.yaml
    [ \$(grep -c '^  block_commit_deadline_ms: [0-9]*\$' \$cfg) = 1 ]
    sed -i -E 's/^(  block_commit_deadline_ms:) [0-9]+\$/\1 $deadline_ms/' \$cfg
    grep -q '^  block_commit_deadline_ms: $deadline_ms\$' \$cfg
    mkdir -p $ZK_RUN && rm -f $ZK_RUN/server.pid && sha256sum \$cfg > $ZK_RUN/config.sha256
    grep -nE 'block_commit_deadline_ms|miniblock_commit_deadline_ms|max_nonce_ahead|pubdata_sending_mode' \$cfg > $ZK_RUN/config.txt
    cd $ZK_COMPOSE && docker compose up -d reth postgres 2>&1 | tail -n 3
    ok=0; for i in \$(seq 60); do docker compose exec -T postgres pg_isready -U postgres -q && { ok=1; break; }; sleep 1; done
    [ \$ok = 1 ] || { echo 'postgres not ready after 60 s' >&2; exit 1; }
    # the server gives up at once if the L1 does not answer when it starts (seen 2026-10-01)
    ok=0; for i in \$(seq 120); do
      curl -s -m 2 -X POST -H 'content-type: application/json' --data '{\"jsonrpc\":\"2.0\",\"method\":\"eth_blockNumber\",\"params\":[],\"id\":1}' \
        http://127.0.0.1:8945 2>/dev/null | grep '\"result\"' >/dev/null && { ok=1; break; }; sleep 1; done
    [ \$ok = 1 ] || { echo 'reth (L1) not answering on 127.0.0.1:8945 after 120 s' >&2; exit 1; }
    other=\$(docker ps --format '{{.Names}}' | grep -v '^${ZK_PROJECT}-' || true)
    [ -z \"\$other\" ] || { echo \"other containers running on bath0: \$other\" >&2; exit 1; }
    cd $ZK_CWD
    setsid nohup $ZK_BIN --genesis-path $C/genesis.yaml --config-path $C/general.yaml --wallets-path $C/wallets.yaml \
      --secrets-path $C/secrets.yaml --contracts-config-path $C/contracts.yaml > $ZK_RUN/server.log 2>&1 < /dev/null &
    echo \$! > $ZK_RUN/server.pid" || die "zkSync snapshot restore / start failed on bath0"
  say "zksync: snapshot restored, server started after $((SECONDS - t0))s; waiting for the APIs"
  local deadline=$((SECONDS + RPC_WAIT_S)) h
  while :; do
    h=$(T=10 on bath0 "pgrep -f '$ZK_PAT' >/dev/null || echo dead; curl -s -m 3 http://127.0.0.1:3071/health" 2>/dev/null || true)
    [ "$h" != dead ] || die "zksync_server exited on bath0 (see bath0:$ZK_RUN/server.log)"
    if grep -q '^{"status":"ready"' <<< "$h" && rpc_ok "$L1" && rpc_ok "$L2_HTTP" && tcp_ok "$STACK_IP" "$L2_WS_PORT"; then break; fi
    [ "$SECONDS" -lt "$deadline" ] || die "zkSync not healthy after ${RPC_WAIT_S}s (L1 $L1: $(rpc_ok "$L1" && echo ok || echo no), L2 $L2_HTTP: $(rpc_ok "$L2_HTTP" && echo ok || echo no), L2 WS :$L2_WS_PORT: $(tcp_ok "$STACK_IP" "$L2_WS_PORT" && echo ok || echo no), health: ${h:0:80}; see bath0:$ZK_RUN/server.log)"
    sleep 3
  done
  echo "zksync up (snapshot restored, block_commit_deadline_ms=$deadline_ms, $((SECONDS - t0))s)"
}

# up_perun — a fresh Anvil on bath0 (any old one is stopped: Anvil keeps no state) and the two Perun contracts,
# deployed from the workstation with the amd64 perun-node of the last sync, at the pinned addresses.
up_perun() {
  local t0=$SECONDS bin="$PERUN_DIST/amd64/perun-node"
  [ -x "$bin" ] || die "no $bin; run deploy/cluster sync"
  T=60 on bath0 "[ -z \"\$(docker ps -q)\" ] || { echo 'containers running on bath0' >&2; exit 1; }
    if pgrep -x anvil >/dev/null; then
      pkill -TERM -x anvil; for i in \$(seq 10); do pgrep -x anvil >/dev/null || break; sleep 1; done
      pkill -KILL -x anvil 2>/dev/null; sleep 1
    fi
    mkdir -p ~/perun || exit 1
    setsid nohup $ANVIL_BIN --host 0.0.0.0 --port 8545 --chain-id $PERUN_CHAIN_ID --block-time 1 > ~/perun/anvil.log 2>&1 < /dev/null &
    echo \$! > ~/perun/anvil.pid" || die "starting Anvil on bath0 failed"
  local deadline=$((SECONDS + RPC_WAIT_S))
  until rpc_ok "$L1"; do
    [ "$SECONDS" -lt "$deadline" ] || die "Anvil not answering at $L1 after ${RPC_WAIT_S}s (see bath0:~/perun/anvil.log)"
    sleep 1
  done
  rm -f "$PERUN_CONTRACTS"
  timeout 180 "$bin" -mode uc1-deploy -url "$PERUN_CHAIN_WS" -chainid "$PERUN_CHAIN_ID" -out "$PERUN_CONTRACTS" \
    > "$PERUN_DIST/uc1-deploy.log" 2>&1 || die "uc1-deploy failed (see $PERUN_DIST/uc1-deploy.log)"
  "$LPY" - "$PERUN_CONTRACTS" "$PERUN_CHAIN_ID" "$PERUN_ADJ" "$PERUN_AH" <<'PY' || die "deployed contracts differ from the pinned ones (see $PERUN_CONTRACTS)"
import json, sys
c = json.load(open(sys.argv[1]))
want = {"chain_id": int(sys.argv[2]), "adjudicator": sys.argv[3].lower(), "asset_holder": sys.argv[4].lower()}
got = {"chain_id": c.get("chain_id"), "adjudicator": str(c.get("adjudicator")).lower(), "asset_holder": str(c.get("asset_holder")).lower()}
if got != want:
    sys.exit(f"contracts.json {got} != pinned {want}")
PY
  echo "perun up (fresh Anvil, contracts at the pinned addresses, $((SECONDS - t0))s)"
}

