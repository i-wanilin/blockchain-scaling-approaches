  T=240 on bath0 "$ZK_STOP
    [ -d $ZK_COMPOSE ] && (cd $ZK_COMPOSE && docker compose stop -t 60 >/dev/null 2>&1)
    cd ~/arbitrum && docker compose stop -t 60 sequencer >/dev/null 2>&1; docker compose stop >/dev/null 2>&1
    if pgrep -x anvil >/dev/null; then pkill -TERM -x anvil; sleep 2; pkill -KILL -x anvil; fi; true" \
    || echo "warning: could not stop the stacks on bath0" >&2
  local h
  for h in "${BOARDS[@]}"; do T=20 on "$h" 'sudo -n tc qdisc del dev wlan0 root 2>/dev/null; true' || true & done; wait
