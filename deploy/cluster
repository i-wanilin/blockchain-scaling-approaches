# uc2_setup_perun OUT RD — fund the hub (110) and the players (111..116) on Anvil; uc2-deploy (the points
# token, START_POINTS minted per player and N x hub_deposit to the hub) -> results/contracts.json; cluster.json
# -> results/ and every player; contracts.json to every player (contracts_file); the hub key (0600) to bath1.
uc2_setup_perun() {
  local out=$1 rd=$2 bin="$PERUN_DIST/amd64/perun-node" mint hub hub_points ips=() h
  [ -x "$bin" ] || die "no $bin; run deploy/cluster sync"
  (cd "$REPO" && timeout 900 "$LPY" - "$L1" "$FUND_WEI" "$N_PLAYERS" <<'PY') || die "funding 110..116 on Anvil failed"
import sys
from web3 import Web3
from measure import arbitrum, keys
url, amount, n = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
l1 = Web3(Web3.HTTPProvider(url, request_kwargs={"timeout": 30}))
for i in [keys.ARENA] + [keys.player_index(k) for k in range(n)]:
    arbitrum.fund_on_l1(l1, keys.account(keys.FUNDER), keys.account(i).address, amount)
print(f"funded {keys.ARENA}..{keys.player_index(n - 1)} on Anvil (perun uc2)")
PY
  mint=$(cd "$REPO" && "$LPY" -c "import sys; from measure import keys; print(','.join(keys.account(keys.player_index(k)).address for k in range(int(sys.argv[1]))))" "$N_PLAYERS") \
    || die "player addresses: measure.keys failed"
  hub=$(cd "$REPO" && "$LPY" -c "from measure import keys; print(keys.account(keys.ARENA).address)") || die "hub address: measure.keys failed"
  hub_points=$("$LPY" -c "import json, sys; print(int(sys.argv[2]) * json.load(open(sys.argv[1]))['hub_deposit'])" "$out/results/bound.json" "$N_PLAYERS") \
    || die "hub points from results/bound.json failed"
  timeout 180 "$bin" -mode uc2-deploy -url "$PERUN_CHAIN_WS" -chainid "$PERUN_CHAIN_ID" -mint "$mint" -points "$START_POINTS" \
      -hub "$hub" -hub-points "$hub_points" -out "$out/results/contracts.json" > "$out/logs/uc2-deploy.out" 2>&1 \
    || die "uc2-deploy failed (see logs/uc2-deploy.out)"
  for h in "${PLAYERS[@]}"; do ips+=("$(board_ip "$h")"); done
  (cd "$REPO" && "$LPY" - "$out/results/bound.json" "$rd" "$PERUN_CHAIN_WS" "$PERUN_CHAIN_ID" "$START_POINTS" \
      "$CHALLENGE_S" "$UPDATE_TIMEOUT_S" "$YIELD_TIMEOUT_MS" "$MAX_COLLISION_RETRIES" "${STRICT_POLICY:-1}" \
      "$HUB_IP" "$HUB_WIRE_PORT" "$HUB_CONTROL_PORT" "$PLAYER_WIRE_PORT" "${ips[@]}" > "$out/results/cluster.json" <<'PY') \
    || die "writing cluster.json failed"
import json, sys
from measure import keys
(bound, rd, chain, chain_id, ledger, challenge, upd, yield_ms, retries, strict,
 hub_ip, hub_wire, hub_ctl, player_wire, *ips) = sys.argv[1:]
b = json.load(open(bound))
cfg = {"chain_url": chain, "chain_id": int(chain_id), "asset": "points",
       "state_root": f"{rd}/perun-state", "result_dir": f"{rd}/hub",
       "ledger_deposit": int(ledger), "virtual_stake": b["virtual_stake"],
       "hub_deposit": b["hub_deposit"], "ammo_reserve": b["ammo"],
       "challenge_seconds": int(challenge), "update_timeout_seconds": int(upd),
       "yield_timeout_ms": int(yield_ms), "max_collision_retries": int(retries),
       "disable_strict_payment_policy": strict != "1",
       "contracts_file": f"{rd}/contracts.json", "hub_key_file": f"{rd}/hub.key",
       "hub": {"name": "arena", "bind": f"0.0.0.0:{hub_wire}", "endpoint": f"{hub_ip}:{hub_wire}",
               "control": f"0.0.0.0:{hub_ctl}", "ethereum": keys.account(keys.ARENA).address},
       "clients": [{"name": f"p{k}", "bind": f"0.0.0.0:{player_wire}", "endpoint": f"{ip}:{player_wire}",
                    "control": f"http://{hub_ip}:{hub_ctl}",
                    "ethereum": keys.account(keys.player_index(k)).address} for k, ip in enumerate(ips)]}
print(json.dumps(cfg, indent=1))
PY
  uc2_ship "$out/results/cluster.json" cluster.json "${PLAYERS[@]}"       # PLAYERS[0] is bath1, the hub's board
  uc2_ship "$out/results/contracts.json" contracts.json "${PLAYERS[@]}"
  (cd "$REPO" && "$LPY" -c "from measure import keys; print(keys.account(keys.ARENA).key.hex())") \
    | timeout 30 ssh "${SSH_OPTS[@]}" "$HUB_BOARD" "umask 077; cat > $rd/hub.key" || die "writing the hub key on $HUB_BOARD failed"
  say "perun: contracts deployed, cluster.json and contracts.json on ${PLAYERS[*]}, hub key on $HUB_BOARD"
}

# uc2_hub OUT RD — start uc2-hub on bath1 (its exit code goes to RD/hub.rc), wait until its control API
# answers here, then from every player. The hub's /v1/manifest carries "RunID" (not UC1's "wire").
uc2_hub() {
  local out=$1 rd=$2 h deadline url="http://$HUB_IP:$HUB_CONTROL_PORT/v1/manifest"
  STAGE="perun hub"
  launch_guarded "$HUB_BOARD" "$PERUN_HUB_PROC" "cd $rd || exit 1; mkdir -p $rd/hub; setsid nohup bash -c '$PERUN_BIN_REMOTE -mode uc2-hub -config $rd/cluster.json; echo \$? > $rd/hub.rc' > $rd/uc2-hub.out 2>&1 < /dev/null &" \
    || die "starting uc2-hub on $HUB_BOARD failed"
  deadline=$((SECONDS + READY_WAIT_S))
  until curl -s -m 3 "$url" | grep -q '"RunID"'; do
    [ "$SECONDS" -lt "$deadline" ] || die "uc2-hub on $HUB_BOARD: no /v1/manifest after ${READY_WAIT_S}s (see logs/$HUB_BOARD-uc2-hub.out)"
    T=20 on "$HUB_BOARD" "pgrep -f '$PERUN_HUB_PROC' >/dev/null" \
      || die "uc2-hub on $HUB_BOARD exited at start (see logs/$HUB_BOARD-uc2-hub.out)"
    sleep 2
  done
  STAGE="perun reachability"
  for h in "${PLAYERS[@]}"; do
    T=30 on "$h" "for i in 1 2 3; do curl -s -m 3 $url | grep -q '\"RunID\"' && exit 0; sleep 2; done; exit 1" \
      || die "$h cannot reach the hub's control API at $HUB_IP:$HUB_CONTROL_PORT"
  done
  say "uc2-hub up on $HUB_BOARD, reachable from ${PLAYERS[*]}"
}

# hub_state RD -> alive | ok | failed:<why> | unreachable. The wrapper (bash -c ... ; echo $? > hub.rc) counts
# as alive until it has written the exit code; ok = exit 0 and the hub's "hub complete:" line.
hub_state() {
  timeout 30 ssh "${SSH_OPTS[@]}" "$HUB_BOARD" python3 - "$1" 2>/dev/null <<'PY' || echo unreachable
import os, re, subprocess, sys
rd = sys.argv[1]
if subprocess.run(["pgrep", "-f", r"[u]c2-hub -config " + rd + r"/cluster\.json"], capture_output=True).returncode == 0:
    print("alive")
    sys.exit()
try:
    rc = open(os.path.join(rd, "hub.rc")).read().strip()
except OSError:
    print("failed: exited without writing hub.rc")
    sys.exit()
try:
    out = open(os.path.join(rd, "uc2-hub.out"), errors="replace").read()
except OSError:
    out = ""
done = re.search(r"^hub complete:", out, re.M) is not None
print("ok" if rc == "0" and done else f"failed: exit {rc or '?'}, {'a' if done else 'no'} 'hub complete' line")
PY
}

# uc2_wait_hub RD — after every payment client completed: until the hub has settled and exited, at most
# SETTLE_WAIT_S. Sets HUB_RES to "ok", or to why not (the caller fails the run after reading the balances).
HUB_RES=""
uc2_wait_hub() {
  local rd=$1 deadline=$((SECONDS + SETTLE_WAIT_S)) st
  while :; do
    st=$(hub_state "$rd"); st=${st%%$'\n'*}
    case "$st" in
      ok) HUB_RES=ok; say "uc2-hub settled and exited"; return 0 ;;
      failed:*) HUB_RES=$st; return 0 ;;
    esac
    [ "$SECONDS" -lt "$deadline" ] || { HUB_RES="not exited after ${SETTLE_WAIT_S}s (${st:-no answer})"; return 0; }
    sleep 5
  done
}

# uc2_setup_rollup OUT — measure.uc2_setup: fund 110..116 and 119 on the L1, deploy the points token, mintBatch
# -> results/token.json, results/recipients.json; recipients.json to every player.
uc2_setup_rollup() {
  local out=$1
  (cd "$REPO" && timeout 1800 "$LPY" -m measure.uc2_setup --stack "$STACK" --l1 "$L1" --l2-http "$L2_HTTP" \
      --players "$N_PLAYERS" --points "$START_POINTS" --fund-wei "$FUND_WEI" --out "$out/results") \
    > "$out/logs/uc2-setup.out" 2>&1 || die "measure.uc2_setup failed (see logs/uc2-setup.out)"
  [ -s "$out/results/token.json" ] && [ -s "$out/results/recipients.json" ] \
    || die "measure.uc2_setup wrote no token.json/recipients.json (see logs/uc2-setup.out)"
  uc2_ship "$out/results/recipients.json" recipients.json "${PLAYERS[@]}"
  say "token: $(tail -n 1 "$out/logs/uc2-setup.out")"
}

# wait_players WANT DEADLINE_S DIR — until every player's payment client is in state WANT (pc_state per board,
# captured with $(...): an unknown or empty answer stays pending until the deadline, never passes).
wait_players() {
  local want=$1 limit=$2 dir=$3 deadline=$((SECONDS + $2)) h s pending
  while :; do
    pending=""
    for h in "${PLAYERS[@]}"; do
      s=$(pc_state "$h" "$dir"); s=${s%%$'\n'*}
      case "$s" in
        failed:*) die "payment client on $h ${s}" ;;
        dead) [ "$want" = complete ] && { s=$(pc_state "$h" "$dir"); s=${s%%$'\n'*}; }   # it may have finished between the two reads
              [ "$s" = complete ] || die "payment client on $h exited before '$want' (see logs/$h-payclient.out)" ;;
      esac
      [ "$s" = "$want" ] || { [ "$want" = ready ] && [ "$s" = complete ]; } || pending="$pending $h:${s:-no answer}"
    done
    [ -n "$pending" ] || return 0
    [ "$SECONDS" -lt "$deadline" ] || die "payment clients not '$want' after ${limit}s:$pending"
    sleep 5
  done
}

# game_state HOST RD -> alive | complete | aborted: <reason> | dead | bad: <why> | unreachable
game_state() {
  timeout 30 ssh "${SSH_OPTS[@]}" "$1" python3 - "$2" 2>/dev/null <<'PY' || echo unreachable
import json, os, subprocess, sys
res = os.path.join(sys.argv[1], "game", "node-result.json")
if subprocess.run(["pgrep", "-f", r"[a]rena\.node .*--result-out " + res + r"( |$)"],
                  capture_output=True).returncode == 0:
    print("alive")
elif not os.path.exists(res):
    print("dead")
else:
    try:
        r = json.load(open(res))
    except (OSError, ValueError) as e:
        print(f"bad: node-result.json unreadable ({e})"[:200])
        sys.exit()
    if r.get("complete") is True and not r.get("aborted"):
        print("complete")
    else:
        print("aborted: " + str(r.get("aborted") or "incomplete, no reason given")[:200])
PY
}

# uc2_wait_game RD DEADLINE_S — until every player's game node has exited with its node-result.json; any
# aborted match, a node that exited without its result, or the deadline fails the run. QUIET_S (optional): no
# polling for that long first (ssh + python3 on every Pi would load CPU and Wi-Fi while tick lag is measured);
# the deadline is unchanged and counts from the call.
uc2_wait_game() {
  local rd=$1 limit=$2 quiet=${3:-0} deadline=$((SECONDS + $2)) h s pending tdir
  [ "$quiet" -le "$limit" ] || quiet=$limit
  [ "$quiet" -le 0 ] || sleep "$quiet"
  tdir=$(mktemp -d)
  while :; do
    pending=""
    for h in "${PLAYERS[@]}"; do game_state "$h" "$rd" > "$tdir/$h" & done
    wait
    for h in "${PLAYERS[@]}"; do
      s=$(head -n 1 "$tdir/$h" 2>/dev/null || true)
      case "$s" in
        complete) ;;
        aborted:*) rm -rf "$tdir"; die "match aborted on $h: ${s#aborted: }" ;;
        dead) rm -rf "$tdir"; die "game node on $h exited without node-result.json (see logs/$h-node.out)" ;;
        bad:*) rm -rf "$tdir"; die "game node on $h: ${s#bad: }" ;;
        *) pending="$pending $h:${s:-no answer}" ;;
      esac
    done
    if [ -z "$pending" ]; then rm -rf "$tdir"; return 0; fi
    [ "$SECONDS" -lt "$deadline" ] || { rm -rf "$tdir"; die "match not finished after ${limit}s:$pending"; }
    sleep 5
  done
}

# uc2_game RD GAME_S — start every player's game node at once (the mesh connects within 15 s,
# arena/node.py CONNECT_TIMEOUT_S), then wait for every result (deadline GAME_S x 3 + 120 s).
uc2_game() {
  local rd=$1 game_s=$2 k=0 h peers="" tdir rc t0=$SECONDS
  for h in "${PLAYERS[@]}"; do peers="$peers${peers:+,}$(board_ip "$h"):$GAME_PORT"; done
  tdir=$(mktemp -d)
  for h in "${PLAYERS[@]}"; do
    ( rc=0
      launch_guarded "$h" "[a]rena\\.node .*--result-out $rd/game/node-result\\.json" \
        "cd ~/measure-code/tank-arena || exit 1; setsid nohup $RPY -m arena.node --id $k --peers $peers --tickrate $TICKRATE \
          --duration $game_s --seed $GAME_SEED --run $RUN_ID --pay-socket $rd/pay.sock --out $rd/game/trace.jsonl \
          --ticks-out $rd/game/ticks.csv --result-out $rd/game/node-result.json > $rd/node.out 2>&1 < /dev/null &" || rc=$?
      echo "$rc" > "$tdir/$h" ) &
    k=$((k + 1))
  done
  wait
  for h in "${PLAYERS[@]}"; do
    rc=$(cat "$tdir/$h" 2>/dev/null || echo "no status")
    [ "$rc" = 0 ] || { rm -rf "$tdir"; die "starting the game node on $h failed ($rc)"; }
  done
  rm -rf "$tdir"
  say "match: ${N_PLAYERS} players, ${game_s}s at ${TICKRATE} Hz, seed $GAME_SEED"
  uc2_wait_game "$rd" $((game_s * 3 + 120)) $((game_s - (SECONDS - t0)))
  say "match complete on ${PLAYERS[*]}"
}

# uc2_points_balances OUT URL — R11: the final points of the six players and the arena, after every payment
# client (and on Perun the hub) completed. Rollups: balanceOf on the L2. Perun: the withdrawn token balances on
# the L1; arena = the hub's net gain = its balance - what it was minted (= withdrawn - N x hub_deposit).
uc2_points_balances() {
  (cd "$REPO" && timeout 120 "$LPY" - "$STACK" "$2" "$1/results" "$N_PLAYERS" <<'PY')
import json, os, sys
from web3 import Web3
from measure import keys, points as pts
system, url, res, n = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
w3 = Web3(Web3.HTTPProvider(url, request_kwargs={"timeout": 30}))
def bal(token, addr):
    return int(w3.eth.call({"to": token, "data": pts.balance_of_data(addr)}).hex(), 16)
players = {f"p{k}": keys.account(keys.player_index(k)).address for k in range(n)}
hub = keys.account(keys.ARENA).address
if system == "perun":
    c = json.load(open(os.path.join(res, "contracts.json")))
    b = json.load(open(os.path.join(res, "bound.json")))
    minted = {Web3.to_checksum_address(a): v for a, v in c["minted"].items()}
    if minted.get(hub) != n * b["hub_deposit"]:
        sys.exit(f"hub minted {minted.get(hub)} != {n} x hub_deposit {b['hub_deposit']}")
    token = Web3.to_checksum_address(c["token"])
    hub_bal = bal(token, hub)
    out = {"players": {p: bal(token, a) for p, a in players.items()}, "arena": hub_bal - minted[hub],
           "hub_balance": hub_bal, "hub_minted": minted[hub], "token": token, "chain": "L1 (Anvil)"}
else:
    t = json.load(open(os.path.join(res, "token.json")))
    rec = pts.load_recipients(os.path.join(res, "recipients.json"), n)
    token = Web3.to_checksum_address(t["token"])
    out = {"players": {p: bal(token, rec[p]) for p in players}, "arena": bal(token, rec["arena"]),
           "token": token, "chain": "L2"}
print(json.dumps(out, indent=1))
PY
}

# uc2_hash_check OUT RD — every board's trace against results/reference.sha256 (ruling P4). The boards' hashes
# go to results/trace-sha256.txt; a differing or unreadable one writes HASH_MISMATCH (the boards) and fails the run.
uc2_hash_check() {
  local out=$1 rd=$2 ref h s bad=""
  ref=$(awk 'NR == 1 {print tolower($1)}' "$out/results/reference.sha256")
  [[ $ref =~ ^[0-9a-f]{64}$ ]] || die "results/reference.sha256 holds no SHA-256"
  : > "$out/results/trace-sha256.txt"
  for h in "${PLAYERS[@]}"; do
    s=$(T=60 on "$h" "sha256sum $rd/game/trace.jsonl | cut -d' ' -f1" 2>/dev/null || true)
    [[ $s =~ ^[0-9a-f]{64}$ ]] || s=unreadable
    echo "$h $s" >> "$out/results/trace-sha256.txt"
    [ "$s" = "$ref" ] || bad="$bad $h"
  done
  if [ -n "$bad" ]; then
    echo "${bad# }" > "$out/HASH_MISMATCH"
    die "trace hash differs from the reference ($ref) on:$bad (see results/trace-sha256.txt)"
  fi
  say "hash ok on ${PLAYERS[*]}: $ref"
}

# collect_uc2 — best effort, as collect: results/p<k>/{pc,game} and the logs of every player, the recorders,
# Perun's results/hub/ and logs/bath1-uc2-hub.out, the stack's logs, the end facts.
collect_uc2() {
  local out=$RUN_OUT rd=/tmp/m-$RUN_ID h k=0
  DEAD_HOSTS=" "
  mkdir -p "$out"/{results,logs,recorder}
  for h in "${PLAYERS[@]}"; do
    mkdir -p "$out/results/p$k/pc" "$out/results/p$k/game"
    collect_dir "$h" "$rd/pc" "$out/results/p$k/pc" "p$k pc"
    collect_dir "$h" "$rd/game" "$out/results/p$k/game" "p$k game"
    scp_h "$h" 60 -q "$h:$rd/payclient.out" "$out/logs/$h-payclient.out" || true
    scp_h "$h" 60 -q "$h:$rd/node.out" "$out/logs/$h-node.out" || true
    k=$((k + 1))
  done
  for h in "${BOARDS[@]}"; do
    scp_h "$h" 60 -q "$h:$rd/rec.csv" "$out/recorder/$h.csv" || true
    scp_h "$h" 60 -q "$h:$rd/recorder.log" "$out/logs/$h-recorder.log" || true
  done
  if [ "${STACK:-}" = perun ]; then
    mkdir -p "$out/results/hub"
    collect_dir "$HUB_BOARD" "$rd/hub" "$out/results/hub" "hub"
    scp_h "$HUB_BOARD" 60 -q "$HUB_BOARD:$rd/uc2-hub.out" "$out/logs/$HUB_BOARD-uc2-hub.out" || true
    scp_h "$HUB_BOARD" 60 -q "$HUB_BOARD:$rd/hub.rc" "$out/logs/$HUB_BOARD-uc2-hub.rc" || true
    scp_h bath0 120 -q "bath0:perun/anvil.log" "$out/logs/bath0-anvil.log" || true
  elif [ "${STACK:-}" = zksync ]; then
    mkdir -p "$out/zk"
    scp_h bath0 600 -q -C "bath0:$ZK_RUN/server.log" "$out/logs/bath0-zksync-server.log" || true
    T=300 on bath0 "cd $ZK_COMPOSE && docker compose logs --no-color --timestamps --since ${RUN_T0:-0}" \
      > "$out/logs/bath0-docker.log" 2>&1 || true
    scp_h bath0 60 -q "bath0:$ZK_RUN/config.txt" "bath0:$ZK_RUN/config.sha256" "$out/results/" || true
    scp_h bath0 60 -q "bath0:$rd/zk.csv" "$out/zk/bath0-sampler.csv" || true
    scp_h bath0 60 -q "bath0:$rd/zk-sampler.log" "$out/logs/bath0-zk-sampler.log" || true
  else
    T=120 on bath0 "cd ~/arbitrum && docker compose logs --no-color --timestamps --since ${RUN_T0:-0}" \
      > "$out/logs/bath0-docker.log" 2>&1 || true
  fi
  gather_facts "$out/facts-end"; gather_clock "$out/chrony-end"
}

# one_run_uc2 EXP REP — one UC2 match (the experiment env is already sourced and BOARDS has the idle boards
# removed). Every wait has a deadline; every failure dies (RUN_FAILED, collection, down: on_exit).
one_run_uc2() {
  local exp=$1 rep=$2
  stack_endpoints "$STACK"
  uc2_params_check
  local ref; ref=$(uc2_reference) || exit 2
  local game_s=$((GAME_TICKS / TICKRATE))
  RUN_ID="$(date +%Y%m%d-%H%M%S)-$STACK-$exp-rep$rep"; RUN_T0=$(date +%s)
  local out="$REPO/results/pi/$USE_CASE/$RUN_ID" rd=/tmp/m-$RUN_ID h k
  mkdir -p "$out"/{results,logs,recorder}; RUN_OUT=$out
  cp "$REPO/deploy/experiments/$exp.env" "$out/experiment.env"
  cp "$REFERENCE_SHA" "$out/results/reference.sha256"       # ruling P4: the run folder carries its reference
  say "run $RUN_ID (uc2 on $STACK: ${PLAYERS[*]}${IDLE_BOARDS:+, idle $IDLE_BOARDS}; reference ${ref:0:16})"

  STAGE="leftovers"
  kill_leftovers TERM; sleep 3; kill_leftovers KILL

  STAGE="code check"; uc2_code_check "$out"
  [ "$STACK" != perun ] || perun_code_check "$out"
  (cd "$REPO/tank-arena" && "$LPY" -c 'from arena.tune import config_digest; print(config_digest(None, None))') \
    > "$out/config-digest.txt" || die "arena.tune.config_digest failed"
  STAGE="run-start commit"; run_start_commit "$out"

  STAGE="down"; cmd_down >/dev/null
  STAGE="cooling gate"; cool_gate "$out"
  STAGE="up"; cmd_up "$STACK"
  STAGE="stack config"; stack_config "$out" "$STACK"
  STAGE="clock gate"; clock_gate "$out"
  STAGE="pre-flight"
  gather_facts "$out/facts-start"; gather_clock "$out/chrony-start"
  (cd "$REPO" && "$LPY" -m measure.preflight "$out/facts-start") | tee "$out/logs/preflight.txt" \
    || die "pre-flight failed (see logs/preflight.txt)"
  STAGE="ports"; uc2_ports

  STAGE="bound"; uc2_bound "$out" "$game_s"

  STAGE="run dirs"
  for h in "${BOARDS[@]}"; do
    T=30 on "$h" "rm -rf $rd && mkdir -p $rd/game" || die "$h: creating $rd failed"
  done
  STAGE="setup"
  if [ "$STACK" = perun ]; then uc2_setup_perun "$out" "$rd"; else uc2_setup_rollup "$out"; fi

  STAGE="recorders"
  local rec_s=$((READY_WAIT_S * 2 + game_s * 3 + 120 + DRAIN_S + $(complete_extra_s) + SETTLE_WAIT_S + 120))   # finish_run stops it
  for h in "${BOARDS[@]}"; do
    scp_try 30 -q "$REPO/deploy/recorder.sh" "$h:$rd/recorder.sh" || die "copying the recorder to $h failed"
    launch_guarded "$h" '[r]ecorder\.sh ' "setsid nohup bash $rd/recorder.sh $rd/rec.csv $rec_s > $rd/recorder.log 2>&1 < /dev/null &" \
      || die "starting the recorder on $h failed"
  done
  if [ "$STACK" = zksync ]; then     # server CPU/RSS and chain progress on bath0
    scp_try 30 -q "$REPO/deploy/zk-sampler.sh" "bath0:$rd/zk-sampler.sh" || die "copying the zk sampler to bath0 failed"
    launch_guarded bath0 '[z]k-sampler\.sh ' "setsid nohup bash $rd/zk-sampler.sh $rd/zk.csv $rec_s $ZK_RUN/server.pid > $rd/zk-sampler.log 2>&1 < /dev/null &" \
      || die "starting the zk sampler on bath0 failed"
  fi

  [ "$STACK" != perun ] || uc2_hub "$out" "$rd"
  STAGE="payment clients"
  local token="" rm_flag=""
  if [ "$STACK" != perun ]; then
    token=$("$LPY" -c "import json, sys; print(json.load(open(sys.argv[1]))['token'])" "$out/results/token.json") \
      || die "no token address in results/token.json"
    [ -z "${RECEIPT_MODE:-}" ] || rm_flag="--receipt-mode $RECEIPT_MODE"
  fi
  k=0
  for h in "${PLAYERS[@]}"; do
    if [ "$STACK" = perun ]; then
      bg "$h" "$rd/payclient.out" "$RPY -m measure.payclient --system perun --use-case uc2 --perun-config $rd/cluster.json \
        --sidecar $PERUN_BIN_REMOTE --deposit-wei 0 --update-timeout $UPDATE_TIMEOUT_S --persist $PERSIST \
        --account $((111 + k)) --max-in-flight $MAX_IN_FLIGHT --max-queue $MAX_QUEUE --drain $DRAIN_S \
        --socket $rd/pay.sock --out $rd/pc" || die "starting the payment client on $h failed"
    else
      bg "$h" "$rd/payclient.out" "$RPY -m measure.payclient --system $STACK --asset points --token $token \
        --recipients $rd/recipients.json --players $N_PLAYERS --l1 $L1 --l2 $L2_WS --deposit-wei $DEPOSIT_WEI \
        --receipt-timeout ${RECEIPT_TIMEOUT_S:-120} --close-timeout ${CLOSE_TIMEOUT_S:-300} $rm_flag \
        --account $((111 + k)) --max-in-flight $MAX_IN_FLIGHT --max-queue $MAX_QUEUE --drain $DRAIN_S \
        --socket $rd/pay.sock --out $rd/pc" || die "starting the payment client on $h failed"
    fi
    k=$((k + 1))
  done
  STAGE="wait ready"; wait_players ready "$READY_WAIT_S" "$rd/pc"; say "payment clients ready on ${PLAYERS[*]}"

  STAGE="match-start temperatures"      # recorded, not gated
  all_temps "$out/.mt"
  { echo "# host temp_c at match start (every payment client ready), $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    for h in "${BOARDS[@]}"; do echo "$h $(cat "$out/.mt/$h" 2>/dev/null)"; done; } > "$out/match-start-temps.txt"
  rm -rf "$out/.mt"

  STAGE="game"; uc2_game "$rd" "$game_s"

  STAGE="wait complete"
  wait_players complete $((DRAIN_S + $(complete_extra_s))) "$rd/pc"; say "payment clients complete"
  if [ "$STACK" = perun ]; then STAGE="wait hub"; uc2_wait_hub "$rd"; fi

  STAGE="points balances"
  local url=$L2_HTTP; [ "$STACK" != perun ] || url=$L1
  uc2_points_balances "$out" "$url" > "$out/results/points-balances.json" || die "reading the points balances failed"
  say "points balances: $(tr -d '\n ' < "$out/results/points-balances.json")"
  [ "$STACK" != perun ] || [ "$HUB_RES" = ok ] || die "uc2-hub on $HUB_BOARD: $HUB_RES (see logs/$HUB_BOARD-uc2-hub.out)"

  STAGE="hash check"; uc2_hash_check "$out" "$rd"
  finish_run ok
}

# uc1_params_check — every customer is an active board (not bath0/bath1, not idle, not unknown, not twice) and
# EXPECTED_CUSTOMERS (what measure/analyze_uc1.py counts a complete run against) is the number of CUSTOMERS;
# checked before any run folder exists, as uc2_params_check does for PLAYERS.
uc1_params_check() {
  local h seen=" "
  for h in "${CUSTOMERS[@]}"; do
    [ "$h" != "$SENSOR_BOARD" ] || die "uc1: $h is the sensor board and cannot be a customer"
    case " ${BOARDS[*]:1} " in *" $h "*) ;; *) die "uc1: customer $h is not an active board (bath0 or idle or unknown)" ;; esac
    case $seen in *" $h "*) die "uc1: $h is in CUSTOMERS twice" ;; esac
    seen="$seen$h "
  done
  [ -n "${EXPECTED_CUSTOMERS:-}" ] || die "uc1: EXPECTED_CUSTOMERS is not set in the experiment file (the analysis would assume 6)"
  [ "$EXPECTED_CUSTOMERS" -eq "${#CUSTOMERS[@]}" ] \
    || die "uc1: EXPECTED_CUSTOMERS=$EXPECTED_CUSTOMERS but CUSTOMERS has ${#CUSTOMERS[@]} boards (${CUSTOMERS[*]})"
}

one_run() {
  local exp=$1 rep=$2
  # IDLE_BOARDS comes from the experiment file alone (UC2 and the final UC1 files, *5mx7*, set bath3)
  unset IDLE_BOARDS; BOARDS=("${ALL_BOARDS[@]}")
  # shellcheck disable=SC1090
  source "$REPO/deploy/experiments/$exp.env"
  apply_idle
  if [ "${USE_CASE:-uc1}" = uc2 ]; then one_run_uc2 "$exp" "$rep"; return; fi
  uc1_params_check
  stack_endpoints "$STACK"
  RUN_ID="$(date +%Y%m%d-%H%M%S)-$STACK-$exp-rep$rep"; RUN_T0=$(date +%s)
  local out="$REPO/results/pi/$USE_CASE/$RUN_ID" rd=/tmp/m-$RUN_ID h n s
  mkdir -p "$out"/{results,logs,recorder}; RUN_OUT=$out
  cp "$REPO/deploy/experiments/$exp.env" "$out/experiment.env"
  say "run $RUN_ID"

  STAGE="leftovers"
  kill_leftovers TERM; sleep 3; kill_leftovers KILL

  STAGE="code check"                 # boards must run exactly the workstation's measure/ code
  local want; want=$(code_hash "$REPO"); echo "$want" > "$out/code-hash.txt"
  for h in "${BOARDS[@]:1}"; do
    s=$(T=30 on "$h" "[ -x ~/venv/bin/python ] && cd ~/measure-code && find measure -name '*.py' -not -path '*/__pycache__/*' | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-16" || true)
    [ "$s" = "$want" ] || die "$h: code ${s:-missing} differs from the workstation ($want); run deploy/cluster sync"
  done
  T=30 on "$SENSOR_BOARD" "[ -s ~/gesl/sigId-$GESL_SIG-PMU.csv ]" || die "GESL CSV missing on $SENSOR_BOARD; run deploy/cluster sync"
  [ "$STACK" != perun ] || perun_code_check "$out"
  STAGE="run-start commit"; run_start_commit "$out"
  STAGE="GESL check"; gesl_check "$out"

  STAGE="down"; cmd_down >/dev/null
  STAGE="cooling gate"; cool_gate "$out"          # before up: the chain does not idle while boards cool
  STAGE="up"; cmd_up "$STACK"
  STAGE="stack config"; stack_config "$out" "$STACK"
  STAGE="clock gate"; clock_gate "$out"
  STAGE="pre-flight"
  gather_facts "$out/facts-start"; gather_clock "$out/chrony-start"
  (cd "$REPO" && "$LPY" -m measure.preflight "$out/facts-start") | tee "$out/logs/preflight.txt" \
    || die "pre-flight failed (see logs/preflight.txt)"

  STAGE="setup"
  local sensor; sensor=$(cd "$REPO" && "$LPY" -c "from measure import keys; print(keys.account(keys.SENSOR).address)")
  if [ "$STACK" = perun ]; then perun_setup "$out"; else     # the rollups: unchanged
  # the sensor (100) and the customers in use (101..100+n), as perun_setup does
  (cd "$REPO" && timeout 900 "$LPY" - "$STACK" "$L1" "$FUND_WEI" "${#CUSTOMERS[@]}" <<'PY') \
    || die "funding accounts 100..$((100 + ${#CUSTOMERS[@]})) on the L1 failed"
import importlib, sys
from web3 import Web3
from measure import keys
stack, url, amount, n = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
m = importlib.import_module("measure." + stack)
l1 = Web3(Web3.HTTPProvider(url, request_kwargs={"timeout": 30}))
funder = getattr(m, "funder", lambda: keys.account(keys.FUNDER))()
if stack == "zksync":     # the snapshot restore resets the funder's balance every run (F8: ~1e38 wei)
    have, need = l1.eth.get_balance(funder.address), (1 + n) * amount + 10**18
    if have < need:
        sys.exit(f"L1 funder {funder.address} holds {have} wei, needs >= {need} ({1 + n} x FUND_WEI + 1 ETH)")
for i in range(keys.SENSOR, keys.SENSOR + n + 1):
    m.fund_on_l1(l1, funder, keys.account(i).address, amount)
print(f"funded {keys.SENSOR}..{keys.SENSOR + n} on the L1 ({stack})")
PY
  # Budget: the deposit must cover every payment (value + fee at today's L2 gas price, gas limit as the payclient sets it).
  (cd "$REPO" && timeout 60 "$LPY" - "$STACK" "$L2_HTTP" "$sensor" "$DURATION_S" "$WINDOW_MS" "$PRICE_WEI" "$DEPOSIT_WEI" \
      > "$out/results/budget.json" <<'PY') || die "budget check failed: deposit too small or not checkable (see results/budget.json)"
import importlib, json, sys
from web3 import Web3
stack, url, to, dur, win, price, dep = sys.argv[1], sys.argv[2], sys.argv[3], *map(int, sys.argv[4:])
m = importlib.import_module("measure." + stack)
l2 = Web3(Web3.HTTPProvider(url, request_kwargs={"timeout": 10}))
try:
    gp = l2.eth.gas_price
    if stack == "arbitrum":   # as before: estimate_payment_gas would estimate from the sensor, which has no L2 funds yet
        limit = int(l2.eth.estimate_gas({"to": to, "value": 0}) * 1.5)
    else:                     # the gas limit the payment client sets (zkSync: fixed PAYMENT_GAS)
        limit = m.estimate_payment_gas(l2, to, to)
except Exception as e:
    print(json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}))
    sys.exit(2)
n = dur * 1000 // win
need = n * (price + limit * gp)
print(json.dumps({"payments_per_customer": n, "l2_gas_price_wei": gp, "gas_limit_est": limit,
                  "need_wei": need, "deposit_wei": dep, "ok": need <= dep}))
sys.exit(0 if need <= dep else 1)
PY
  fi
  cat "$out/results/budget.json"

  STAGE="recorders"
  local rec_s=$((READY_WAIT_S + SENSOR_WAIT_S + DURATION_S + DRAIN_S + $(complete_extra_s) + 120))   # finish_run stops it
  [ "$STACK" != perun ] || rec_s=$((rec_s + READY_WAIT_S + SETTLE_WAIT_S))   # + sensor node start, + settle
  for h in "${BOARDS[@]}"; do
    T=30 on "$h" "rm -rf $rd && mkdir -p $rd"
    scp_try 30 -q "$REPO/deploy/recorder.sh" "$h:$rd/recorder.sh"
    launch_guarded "$h" '[r]ecorder\.sh ' "setsid nohup bash $rd/recorder.sh $rd/rec.csv $rec_s > $rd/recorder.log 2>&1 < /dev/null &"
  done
  if [ "$STACK" = zksync ]; then     # server CPU/RSS and chain progress on bath0
    scp_try 30 -q "$REPO/deploy/zk-sampler.sh" "bath0:$rd/zk-sampler.sh"
    launch_guarded bath0 '[z]k-sampler\.sh ' "setsid nohup bash $rd/zk-sampler.sh $rd/zk.csv $rec_s $ZK_RUN/server.pid > $rd/zk-sampler.log 2>&1 < /dev/null &"
  fi

  [ "$STACK" != perun ] || perun_sensor_node "$out" "$rd"
  STAGE="payment clients"
  n=1
  for h in "${CUSTOMERS[@]}"; do
    if [ "$STACK" = perun ]; then
      bg "$h" "$rd/payclient.out" "$RPY -m measure.payclient --system perun --chain $PERUN_CHAIN_WS --chain-id $PERUN_CHAIN_ID \
        --sensor-control http://$SENSOR_IP:$PERUN_CONTROL_PORT --sidecar $PERUN_BIN_REMOTE \
        --wire-bind 0.0.0.0:$PERUN_WIRE_PORT --wire-endpoint $(board_ip "$h"):$PERUN_WIRE_PORT \
        --account $((100 + n)) --pay-to $sensor --deposit-wei $DEPOSIT_WEI --max-in-flight $MAX_IN_FLIGHT \
        --max-queue $MAX_QUEUE --drain $DRAIN_S --update-timeout $UPDATE_TIMEOUT_S --persist $PERSIST \
        --socket $rd/pay.sock --out $rd/pc"
    else
      local rm_flag=""
      [ -z "${RECEIPT_MODE:-}" ] || rm_flag="--receipt-mode $RECEIPT_MODE"
      bg "$h" "$rd/payclient.out" "$RPY -m measure.payclient --system $STACK --l1 $L1 --l2 $L2_WS \
        --account $((100 + n)) --pay-to $sensor --deposit-wei $DEPOSIT_WEI --max-in-flight $MAX_IN_FLIGHT \
        --max-queue $MAX_QUEUE --drain $DRAIN_S --receipt-timeout ${RECEIPT_TIMEOUT_S:-120} \
        --close-timeout ${CLOSE_TIMEOUT_S:-300} $rm_flag --socket $rd/pay.sock --out $rd/pc"
    fi
    n=$((n + 1))
  done
  STAGE="wait ready"; wait_payclients ready "$READY_WAIT_S" "$rd/pc"; say "payment clients ready"

  local before
  if [ "$STACK" = perun ]; then     # the sensor's L1 (Anvil) balance: it sends no transaction before Close
    before=$(cast_balance "$sensor" "$L1")
  else
    before=$(timeout 20 "$CAST" balance "$sensor" --rpc-url "$L2_HTTP" 2>/dev/null || echo null)
  fi

  STAGE="sensor"
  bg "$SENSOR_BOARD" "$rd/sensor.log" "$RPY -m measure.sensor --csv ~/gesl/sigId-$GESL_SIG-PMU.csv \
    --port $SENSOR_PORT --customers ${#CUSTOMERS[@]} --duration $DURATION_S --wait-timeout $SENSOR_WAIT_S \
    --queue-max ${SENSOR_QUEUE_MAX:-240} --write-timeout ${SENSOR_WRITE_TIMEOUT_S:-5} --out $rd/sent.csv"
  local deadline=$((SECONDS + SENSOR_WAIT_S))
  until tcp_ok "$SENSOR_IP" "$SENSOR_PORT"; do
    [ "$SECONDS" -lt "$deadline" ] || die "sensor not listening on $SENSOR_IP:$SENSOR_PORT after ${SENSOR_WAIT_S}s"
    sleep 1
  done
  local st_pid=""
  if [ "$STACK" = zksync ] || [ "$STACK" = perun ]; then     # Q4: temperatures at stream start, recorded (not gated), in parallel
    ( all_temps "$out/.st"
      { echo "# host temp_c at stream start (sensor listening), $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        for h in "${BOARDS[@]}"; do echo "$h $(cat "$out/.st/$h" 2>/dev/null)"; done; } > "$out/stream-start-temps.txt"
      rm -rf "$out/.st" ) &
    st_pid=$!
  fi

  STAGE="customers"
  n=1
  for h in "${CUSTOMERS[@]}"; do
    bg "$h" "$rd/customer.log" "$RPY -m measure.customer --sensor $SENSOR_IP:$SENSOR_PORT --customer $n --run $RUN_ID \
      --window-ms $WINDOW_MS --pay-to $sensor --price-wei $PRICE_WEI --socket $rd/pay.sock --out $rd/recv.csv"
    n=$((n + 1))
  done
  say "streaming ${DURATION_S}s at window ${WINDOW_MS} ms"
  [ -z "$st_pid" ] || wait "$st_pid" || true

  STAGE="wait complete"
  wait_payclients complete $((DURATION_S + DRAIN_S + $(complete_extra_s))) "$rd/pc"
  if [ "$STACK" = perun ]; then
    STAGE="wait settle"; perun_wait_settle "$rd"
    local after; after=$(cast_balance "$sensor" "$L1")
    echo "{\"stack\": \"perun\", \"sensor\": \"$sensor\", \"l1_balance_before_wei\": $before, \"l1_balance_after_wei\": $after}" \
      > "$out/results/sensor-balance.json"
    [ "$PERUN_SRES" = complete ] || die "Perun sensor node on $SENSOR_BOARD: $PERUN_SRES (see logs/$SENSOR_BOARD-perun-sensor.out)"
    finish_run ok; return
  fi
  local after; after=$(timeout 20 "$CAST" balance "$sensor" --rpc-url "$L2_HTTP" 2>/dev/null || echo null)
  echo "{\"sensor\": \"$sensor\", \"l2_balance_before_wei\": $before, \"l2_balance_after_wei\": $after}" \
    > "$out/results/sensor-balance.json"
  finish_run ok
}

cmd_run() {
  local exp=${1:-} reps=1
  # shellcheck disable=SC2015
  [ -n "$exp" ] && [ -f "$REPO/deploy/experiments/$exp.env" ] || { echo "no experiment '$exp' in deploy/experiments/" >&2; exit 2; }
  if [ "${2:-}" = --reps ]; then reps=${3:-}; fi
  [[ $reps =~ ^[1-9][0-9]*$ ]] || { echo "--reps needs a positive number" >&2; exit 2; }
  local use; use=$(unset USE_CASE; # shellcheck disable=SC1090
                    source "$REPO/deploy/experiments/$exp.env" >/dev/null; echo "${USE_CASE:-uc1}") \
    || { echo "cannot read deploy/experiments/$exp.env" >&2; exit 2; }
  [ "$use" != uc2 ] || uc2_reference > /dev/null || exit 2      # refuse a UC2 run without the reference log hash
  trap on_exit EXIT
  trap 'FAIL_REASON="interrupted"; exit 130' INT TERM
  local rep
  for rep in $(seq 1 "$reps"); do one_run "$exp" "$rep"; done
}

# IDLE_BOARDS from the environment (sync, status, preflight, ...); `run` resets it per experiment (one_run).
# Unset, it defaults to bath3 (dead since 2026-10-05); IDLE_BOARDS= (empty) includes every board. Exported so
# measure.preflight (`deploy/cluster preflight`, no experiment.env) sees the same idle set.
IDLE_BOARDS=${IDLE_BOARDS-bath3}; export IDLE_BOARDS
apply_idle
case "${1:-}" in
  sync) cmd_sync ;; up) cmd_up "${2:-}" ;; down) cmd_down ;; status) cmd_status ;;
  preflight) cmd_preflight ;; idle-temps) cmd_idle_temps ;; run) shift; cmd_run "$@" ;;
  *) echo "usage: $0 sync|up <stack>|down|status|preflight|idle-temps|run <experiment> [--reps N]" >&2; exit 2 ;;
esac
