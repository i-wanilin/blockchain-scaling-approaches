# Cooling gate (spec §5, decided 2026-09-30, revised the same day): a run starts only
# when every board is within COOL_DELTA_C of its own idle temperature, waiting at most
# COOL_MAX_S. The idle temperatures come from `deploy/cluster idle-temps` (stack down,
# boards idle); idle and start temperatures go into the run folder.
COOL_DELTA_C=${COOL_DELTA_C:-3}; COOL_MAX_S=${COOL_MAX_S:-1200}
IDLE_TEMPS="$REPO/results/pi/idle-temps.txt"
board_temp() { T=15 on "$1" "vcgencmd measure_temp | tr -dc '0-9.'" 2>/dev/null || true; }
all_temps() {            # all_temps DIR — DIR/<host> = temperature, all boards in parallel (ssh to a Pi 3B takes ~4 s)
  local h; mkdir -p "$1"
  for h in "${BOARDS[@]}"; do board_temp "$h" > "$1/$h" & done
  wait
}

cmd_idle_temps() {
  local h n; n=$(T=20 on bath0 "pgrep -f '$ZK_PAT' >/dev/null && echo zksync_server; pgrep -x anvil >/dev/null && echo anvil; docker ps -q | wc -l" || echo unreadable)
  [ "$n" = 0 ] || die "the stack must be down for idle temperatures (bath0: ${n//$'\n'/ } running); run deploy/cluster down"
  for h in "${BOARDS[@]}"; do
    [ "$(T=20 on "$h" "pgrep -f '$LEFTOVERS' | wc -l" || echo x)" = 0 ] || die "$h: measure processes running or board unreachable; not idle"
  done
  local tmp i; tmp=$(mktemp -d)
  for i in 1 2 3; do
    [ "$i" = 1 ] || sleep 30
    all_temps "$tmp/r$i"
    for h in "${BOARDS[@]}"; do { cat "$tmp/r$i/$h"; echo; } >> "$tmp/$h"; done
    say "idle sample $i/3 taken"
  done
  mkdir -p "$(dirname "$IDLE_TEMPS")"
  {
    echo "# idle temperatures, median of 3 samples 30 s apart, stack down; measured $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    for h in "${BOARDS[@]}"; do
      local v; v=$(grep -E '^[0-9.]+$' "$tmp/$h" | sort -n | awk '{a[NR]=$1} END{if (NR==3) print a[2]; else if (NR) print a[int((NR+1)/2)]}')
      [ -n "$v" ] || { rm -rf "$tmp"; die "$h: no temperature readable"; }
      echo "$h $v"
    done
  } > "$IDLE_TEMPS.tmp"
  mv "$IDLE_TEMPS.tmp" "$IDLE_TEMPS"; rm -rf "$tmp"
  cat "$IDLE_TEMPS"
}

cool_gate() {
  local out=$1 waited=0 hot h t idle tdir="$1/.temps"
  [ -s "$IDLE_TEMPS" ] || die "no idle temperatures ($IDLE_TEMPS); run deploy/cluster idle-temps first"
  while :; do
    hot=""
    { echo "# host idle_c start_c (gate: start <= idle + ${COOL_DELTA_C}); $(grep '^#' "$IDLE_TEMPS" | head -1 | sed 's/^# //')"
      echo "# checked $(date -u +%Y-%m-%dT%H:%M:%SZ) after ${waited}s"; } > "$out/start-temps.txt.tmp"
    all_temps "$tdir"
    for h in "${BOARDS[@]}"; do
      idle=$(awk -v h="$h" '$1 == h {print $2}' "$IDLE_TEMPS")
      [ -n "$idle" ] || die "$h has no idle temperature in $IDLE_TEMPS; run deploy/cluster idle-temps"
      t=$(cat "$tdir/$h")
      echo "$h $idle ${t:-unreadable}" >> "$out/start-temps.txt.tmp"
      if [ -z "$t" ]; then hot="$hot $h:unreadable"
      elif awk -v t="$t" -v i="$idle" -v d="$COOL_DELTA_C" 'BEGIN{exit !(t > i + d)}'; then hot="$hot $h:$t(idle $idle)"; fi
    done
    mv "$out/start-temps.txt.tmp" "$out/start-temps.txt"; rm -rf "$tdir"
    if [ -z "$hot" ]; then say "cool: every board within ${COOL_DELTA_C} C of idle after ${waited}s"; return 0; fi
    [ "$waited" -lt "$COOL_MAX_S" ] || die "cooling gate: still hot after ${COOL_MAX_S}s:$hot"
    say "cooling: waiting for$hot"
    sleep 30; waited=$((waited + 30))
  done
}

# proc_state HOST PATTERN LOG -> alive | done (exited after printing its result line) | dead | unreachable
proc_state() {
  T=30 on "$1" "if pgrep -f '$2' >/dev/null; then echo alive; elif grep -q '^{' $3 2>/dev/null; then echo done; else echo dead; fi" \
    2>/dev/null || echo unreachable
}

# Clock-settle gate (2026-09-30): after a heavy run a board's chrony offset to the time server can sit
# above the pre-flight limit for a few minutes. Before pre-flight, wait until every board except the
# time server has |offset| < CLOCK_MAX_MS, at most CLOCK_MAX_S. Pre-flight itself is unchanged.
CLOCK_MAX_MS=${CLOCK_MAX_MS:-5}; CLOCK_MAX_S=${CLOCK_MAX_S:-600}; CLOCK_POLL_S=${CLOCK_POLL_S:-20}; CLOCK_GOOD_POLLS=${CLOCK_GOOD_POLLS:-2}
# chronyc -c tracking: [3]=stratum, [5]=system time offset (s), [14]=leap status. An unsynchronised chrony
# reports offset 0 and stratum 0 / "Not synchronised": that must never look settled, so print nothing then.
offset_ms_of() {         # stdin: one `chronyc -c tracking` line; stdout: offset in ms, or nothing
  awk -F, 'NF >= 14 && $3 ~ /^[0-9]+$/ && $3 > 0 && $14 !~ /Not synchronised/ &&
           $5 ~ /^[-+]?[0-9]+(\.[0-9]*)?([eE][-+]?[0-9]+)?$/ {printf "%.3f", $5 * 1000}'
}
board_offset_ms() { T=15 on "$1" 'chronyc -c tracking' 2>/dev/null | offset_ms_of || true; }
all_offsets() {          # all_offsets DIR — DIR/<host> = chrony offset in ms, every board except the time server, in parallel
  local h; mkdir -p "$1"
  for h in "${BOARDS[@]}"; do [ "$h" = "$SENSOR_BOARD" ] || board_offset_ms "$h" > "$1/$h" & done
  wait
}

clock_gate() {       # passes on CLOCK_GOOD_POLLS (2) consecutive polls with every board settled
  local out=$1 waited=0 bad h v first="" last="" tdir="$1/.offsets" good=0 t0=$SECONDS
  while :; do
    bad=""; last=""; waited=$((SECONDS - t0))
    all_offsets "$tdir"
    for h in "${BOARDS[@]}"; do
      [ "$h" != "$SENSOR_BOARD" ] || continue
      v=$(cat "$tdir/$h")
      last="$last$h ${v:-unreadable}"$'\n'
      if [ -z "$v" ]; then bad="$bad $h:unreadable"
      elif awk -v v="$v" -v m="$CLOCK_MAX_MS" 'BEGIN{if (v < 0) v = -v; exit !(v >= m)}'; then bad="$bad $h:${v}ms"; fi
    done
    rm -rf "$tdir"
    [ -n "$first" ] || first="# start: after ${waited}s, $(date -u +%Y-%m-%dT%H:%M:%SZ)"$'\n'"$last"
    { echo "# clock-settle gate: every board except $SENSOR_BOARD needs |offset| < ${CLOCK_MAX_MS} ms on ${CLOCK_GOOD_POLLS} consecutive polls, waiting at most ${CLOCK_MAX_S}s (host offset_ms)"
      printf '%s' "$first"
      echo "# end: after ${waited}s, $(date -u +%Y-%m-%dT%H:%M:%SZ), good polls in a row: $((good + (${#bad} == 0)))"
      printf '%s' "$last"; } > "$out/clock-gate.txt"
    if [ -z "$bad" ]; then
      good=$((good + 1))
      if [ "$good" -ge "$CLOCK_GOOD_POLLS" ]; then say "clocks settled: every board within ${CLOCK_MAX_MS} ms on $good polls, after ${waited}s"; return 0; fi
    else
      good=0
      [ "$waited" -lt "$CLOCK_MAX_S" ] || die "clock gate: offsets still >= ${CLOCK_MAX_MS} ms (or unsynchronised) after ${CLOCK_MAX_S}s:$bad"
      say "clocks settling: waiting for$bad"
    fi
    sleep "$CLOCK_POLL_S"
  done
}

# pc_state HOST DIR -> complete | failed:<why> | dead | ready | starting | unreachable
pc_state() {
  timeout 30 ssh "${SSH_OPTS[@]}" "$1" python3 - "$2" 2>/dev/null <<'PY' || echo unreachable
import json, os, subprocess, sys
d = sys.argv[1]
alive = subprocess.run(["pgrep", "-f", r"[m]easure\.payclient .*--out " + d + r"( |$)"],
                       capture_output=True).returncode == 0
try:
    life = json.load(open(os.path.join(d, "lifecycle.json")))
except (OSError, ValueError):
    life = {}
if life.get("complete"):
    print("complete")
elif any(life.get(k) for k in ("open_error", "close_error", "error")):
    k = next(k for k in ("open_error", "close_error", "error") if life.get(k))
    print(f"failed:{k}: {str(life[k])[:200]}")
elif not alive:
    print("dead")
elif os.path.exists(os.path.join(d, "ready")):
    print("ready")
else:
    print("starting")
PY
}

# wait_payclients WANT DEADLINE_S DIR — until every customer board is in state WANT.
wait_payclients() {
  local want=$1 limit=$2 dir=$3 deadline=$((SECONDS + $2)) h s pending rd=${3%/pc}
  while :; do
    pending=""
    if [ "$want" = complete ]; then     # the stream side: a sensor or customer that died early ends the run
      s=$(proc_state "$SENSOR_BOARD" "[m]easure\.sensor .*--out $rd/sent\.csv" "$rd/sensor.log")
      [ "$s" != dead ] || die "sensor on $SENSOR_BOARD exited without its result (see logs/$SENSOR_BOARD-sensor.log)"
      for h in "${CUSTOMERS[@]}"; do
        s=$(proc_state "$h" "[m]easure\.customer .*--out $rd/recv\.csv" "$rd/customer.log")
        [ "$s" != dead ] || die "customer on $h exited without its result (see logs/$h-customer.log)"
      done
    fi
    for h in "${CUSTOMERS[@]}"; do
      s=$(pc_state "$h" "$dir")
      case "$s" in
        failed:*) die "payment client on $h ${s}" ;;
        dead) [ "$want" = complete ] && s=$(pc_state "$h" "$dir")   # it may have finished between the two reads
              [ "$s" = complete ] || die "payment client on $h exited before '$want' (see logs/$h-payclient.out)" ;;
      esac
      [ "$s" = "$want" ] || { [ "$want" = ready ] && [ "$s" = complete ]; } || pending="$pending $h:$s"
    done
    [ -n "$pending" ] || return 0
    [ "$SECONDS" -lt "$deadline" ] || die "payment clients not '$want' after ${limit}s:$pending"
    sleep 5
  done
}

kill_leftovers() {       # kill_leftovers TERM|KILL [PATTERN] — every measure process and recorder on every board
  local h pat=${2:-$LEFTOVERS}
  for h in "${BOARDS[@]}"; do T=20 on "$h" "pkill -$1 -f '$pat'; true" >/dev/null 2>&1 || true & done
  wait
}

# wait_gone PATTERN SECONDS — until no board runs a process matching PATTERN (bracketed, self-safe), at most
# SECONDS. Boards are asked in parallel; an unreachable board counts as gone (finish_run must not hang on it).
wait_gone() {
  local pat=$1 deadline=$((SECONDS + $2)) h left tdir; tdir=$(mktemp -d)
  while :; do
    for h in "${BOARDS[@]}"; do (T=20 on "$h" "pgrep -f '$pat' >/dev/null && echo $h" > "$tdir/$h" 2>/dev/null || true) & done
    wait
    left=$(cat "$tdir"/* | tr '\n' ' ')
    if [ -z "${left// /}" ]; then rm -rf "$tdir"; return 0; fi
    if [ "$SECONDS" -ge "$deadline" ]; then echo "still running after ${2}s on: $left" >&2; rm -rf "$tdir"; return 1; fi
    sleep 5
  done
}

# Current repetition (read by the EXIT trap).
RUN_OUT=""; RUN_ID=""; RUN_T0=""; STAGE=""

# scp_h HOST SECONDS SCP_ARGS... — scp_try, but once a host has failed with a connection error (255 after
# the retries) its remaining files are skipped, so a dead board costs one retry round, not one per file.
DEAD_HOSTS=" "
scp_h() {
  local h=$1 rc=0; shift
  case $DEAD_HOSTS in *" $h "*) echo "collect: $h unreachable, skipping $*" >&2; return 0 ;; esac
  scp_try "$@" || rc=$?
  [ "$rc" -ne 255 ] || DEAD_HOSTS="$DEAD_HOSTS$h "
  return "$rc"
}

# copy_timeout BYTES — seconds for one directory copy: 300, plus 10 s per MB above 10 MB (a Perun w10
# customer's pc/ is ~57 MB uncompressed: 770 s; bath2 moved only 15-46 kB/s in the 2026-10-04 w10 runs).
copy_timeout() { local mb=$(( $1 / 1000000 )); echo $(( 300 + (mb > 10 ? (mb - 10) * 10 : 0) )); }
# copy_gaps LOCAL_DIR < "SIZE RELPATH" lines — the files missing locally or of another size, one per line.
copy_gaps() {
  local d=$1 size rel got
  while read -r size rel; do
    [ -n "$rel" ] || continue
    got=$(stat -c %s "$d/$rel" 2>/dev/null || echo missing)
    [ "$got" = "$size" ] || echo "$rel: $got of $size bytes"
  done
}
# collect_dir HOST REMOTE_DIR LOCAL_DIR LABEL — copy a board directory (scp -r, compressed on the wire, with a
# timeout scaled to its size) and check every file's size against the board's list (final review I3: the
# 300 s pc/ copy of bath2 timed out silently in three w10 runs). A failed copy, a missing or short file, or
# an unreadable list is appended to RUN_OUT/COLLECT_INCOMPLETE and reported; never fatal (collect is best effort).
collect_dir() {
  local h=$1 src=$2 dst=$3 label=$4 list lrc=0 total rc=0 gaps
  case $DEAD_HOSTS in *" $h "*)
    echo "$label ($h:$src): not copied, $h unreachable" >> "$RUN_OUT/COLLECT_INCOMPLETE"
    echo "collect: $label not copied, $h unreachable (see COLLECT_INCOMPLETE)" >&2; return 0 ;; esac
  list=$(T=60 on "$h" "cd $src && find . -type f -printf '%s %P\\n'") || lrc=$?
  [ "$lrc" -ne 255 ] || DEAD_HOSTS="$DEAD_HOSTS$h "
  total=$(awk '{s += $1} END {print s + 0}' <<<"$list")
  scp_h "$h" "$(copy_timeout "$total")" -q -C -r "$h:$src/." "$dst/" || rc=$?
  gaps=$(copy_gaps "$dst" <<<"$list")
  if [ "$lrc" -ne 0 ] || [ "$rc" -ne 0 ] || [ -n "$gaps" ]; then
    # shellcheck disable=SC2001  # one indent per line of a multi-line list
    { echo "$label ($h:$src -> $dst): scp exit $rc$([ "$lrc" -eq 0 ] || echo ", file list not readable (exit $lrc)")"
      [ -z "$gaps" ] || sed 's/^/  /' <<<"$gaps"; } >> "$RUN_OUT/COLLECT_INCOMPLETE"
    echo "collect: $label incomplete (see COLLECT_INCOMPLETE)" >&2
  fi
  return 0
}

collect() {   # best effort: whatever exists on the boards goes into the run folder
  local out=$RUN_OUT rd=/tmp/m-$RUN_ID h n=1
  DEAD_HOSTS=" "
  mkdir -p "$out"/{results,logs,recorder}
  scp_h "$SENSOR_BOARD" 120 -q "$SENSOR_BOARD:$rd/sent.csv" "$out/results/rows_sent.csv" || true
  scp_h "$SENSOR_BOARD" 60 -q "$SENSOR_BOARD:$rd/sensor.log" "$out/logs/$SENSOR_BOARD-sensor.log" || true
  for h in "${CUSTOMERS[@]}"; do
    mkdir -p "$out/results/c$n"
    collect_dir "$h" "$rd/pc" "$out/results/c$n" "c$n"
    scp_h "$h" 120 -q "$h:$rd/recv.csv" "$out/results/c$n/rows_received.csv" || true
    scp_h "$h" 60 -q "$h:$rd/payclient.out" "$out/logs/$h-payclient.out" || true
    scp_h "$h" 60 -q "$h:$rd/customer.log" "$out/logs/$h-customer.log" || true
    n=$((n + 1))
  done
  for h in "${BOARDS[@]}"; do
    scp_h "$h" 60 -q "$h:$rd/rec.csv" "$out/recorder/$h.csv" || true
    scp_h "$h" 60 -q "$h:$rd/recorder.log" "$out/logs/$h-recorder.log" || true
  done
  if [ "${STACK:-}" = perun ]; then
    mkdir -p "$out/results/sensor"
    collect_dir "$SENSOR_BOARD" "$rd/ps" "$out/results/sensor" "sensor"
    scp_h "$SENSOR_BOARD" 60 -q "$SENSOR_BOARD:$rd/perun-sensor.out" "$out/logs/$SENSOR_BOARD-perun-sensor.out" || true
    scp_h bath0 120 -q "bath0:perun/anvil.log" "$out/logs/bath0-anvil.log" || true
  elif [ "${STACK:-}" = zksync ]; then
    mkdir -p "$out/zk"
    scp_h bath0 600 -q -C "bath0:$ZK_RUN/server.log" "$out/logs/bath0-zksync-server.log" || true
    T=300 on bath0 "cd $ZK_COMPOSE && docker compose logs --no-color --timestamps --since ${RUN_T0:-0}" \
      > "$out/logs/bath0-docker.log" 2>&1 || true
    scp_h bath0 60 -q "bath0:$ZK_RUN/config.txt" "bath0:$ZK_RUN/config.sha256" "$out/results/" || true
    # R7: the zk sampler CSV is not a board recorder; keep it out of recorder/ so manifest.py:186
    # and analyze_uc1.py:292's "recorder/*.csv" globs stay board-only.
    scp_h bath0 60 -q "bath0:$rd/zk.csv" "$out/zk/bath0-sampler.csv" || true
    scp_h bath0 60 -q "bath0:$rd/zk-sampler.log" "$out/logs/bath0-zk-sampler.log" || true
  else
    T=120 on bath0 "cd ~/arbitrum && docker compose logs --no-color --timestamps --since ${RUN_T0:-0}" \
      > "$out/logs/bath0-docker.log" 2>&1 || true
  fi
  gather_facts "$out/facts-end"; gather_clock "$out/chrony-end"
}

write_manifest() {
  (cd "$REPO" && "$LPY" -m measure.manifest "$RUN_OUT") || echo "warning: manifest failed" >&2
}

compress_run() {     # best-effort: gzip the big files; a failure here never fails a good run
  (cd "$REPO" && "$LPY" -m measure.compress "$RUN_OUT") || echo "warning: compress failed; run folder left uncompressed" >&2
}

finish_run() {       # finish_run ok|failed — stop processes, collect, manifest, down
  local how=$1
  STAGE="finish"
  if [ "${STACK:-}" = perun ]; then
    # A Perun payclient's orderly shutdown (quiesce, Close, sidecar stop) takes up to ~45 s and needs the sensor
    # node alive for the cooperative close: TERM the measure processes first and wait for the payment clients,
    # then TERM the perun-nodes (the sensor node writes sensor-result.json on TERM; if every channel broke, its
    # settle deadline never starts, so only TERM stops it), then KILL what is left.
    kill_leftovers TERM '[m]easure\.(payclient|sensor|customer)'
    wait_gone '[m]easure\.payclient ' "$PERUN_TERM_GRACE_S" || true
    kill_leftovers TERM; wait_gone "$PERUN_PROC" 30 || true; kill_leftovers KILL
  else
    kill_leftovers TERM; sleep 10; kill_leftovers KILL   # TERM first: payclients still write lifecycle/ledger
  fi
  if [ "${USE_CASE:-uc1}" = uc2 ]; then collect_uc2; else collect; fi
  write_manifest
  compress_run
  cmd_down >/dev/null || true
  if [ -f "$RUN_OUT/COLLECT_INCOMPLETE" ]; then
    say "WARNING: collection incomplete, raw files missing or short (analysis may still use ledger.csv):"
    sed 's/^/    /' "$RUN_OUT/COLLECT_INCOMPLETE"
  fi
  if [ "$how" = ok ]; then say "run complete: $RUN_OUT"; else say "run FAILED: $RUN_OUT"; fi
  RUN_OUT=""
}

on_exit() {
  local rc=$?
  set +e; trap - EXIT INT TERM
  if [ -n "$RUN_OUT" ]; then
    [ -n "$FAIL_REASON" ] || FAIL_REASON="stage \"$STAGE\" failed (exit $rc)"
    echo "$FAIL_REASON" > "$RUN_OUT/RUN_FAILED"
    echo "run failed during \"$STAGE\": $FAIL_REASON; collecting and bringing the cluster down" >&2
    finish_run failed
    [ "$rc" -ne 0 ] || rc=1
  fi
  exit "$rc"
}

# ---- Perun (STACK=perun) pieces of one_run --------------------------------------------------------------
board_ip() { echo "192.168.178.21${1#bath}"; }      # bathN -> 192.168.178.21N (deploy/FLEET.md)
# cast_balance ADDR URL — the balance in wei as a bare integer (JSON), or null if it could not be read
cast_balance() {
  local v; v=$(timeout 20 "$CAST" balance "$1" --rpc-url "$2" 2>/dev/null || true)
  if [[ $v =~ ^[0-9]+$ ]]; then echo "$v"; else echo null; fi
}

# perun_code_check OUT — every board runs the perun-node that the last sync built from today's perun/ tree.
perun_code_check() {
  local out=$1 want h s tree
  want=$(cat "$PERUN_DIST/arm64/perun-node.sha256" 2>/dev/null) || die "no $PERUN_DIST/arm64/perun-node.sha256; run deploy/cluster sync"
  [ -z "$(git -C "$REPO" status --porcelain -- perun)" ] || die "perun/ has uncommitted changes (the binary must match a commit)"
  tree=$(awk '$1 == "perun_tree" {print $2}' "$PERUN_DIST/arm64/perun-node.build" 2>/dev/null || true)
  [ "$tree" = "$(perun_tree)" ] || die "perun/ changed since the last sync (built from tree ${tree:-unknown}); run deploy/cluster sync"
  for h in "${BOARDS[@]:1}"; do
    s=$(T=30 on "$h" "sha256sum $PERUN_BIN_REMOTE 2>/dev/null | cut -d' ' -f1" || true)
    [ "$s" = "$want" ] || die "$h: perun-node ${s:-missing} differs from sync's build ($want); run deploy/cluster sync"
  done
  echo "$want" > "$out/perun-node-sha256.txt"
  cp "$PERUN_DIST/arm64/perun-node.build" "$out/perun-node-build.txt"
}

# perun_setup OUT — fund the sensor (100) and the customers in use (101..100+n) on Anvil from index 0; the
# budget (every payment fits the deposit; the gas money outside the channel covers Open + Close ten times at
# today's base fee); contracts.json into results/.
perun_setup() {
  local out=$1
  [ -s "$PERUN_CONTRACTS" ] || die "no $PERUN_CONTRACTS (deploy/cluster up perun writes it)"
  cp "$PERUN_CONTRACTS" "$out/results/contracts.json"
  (cd "$REPO" && timeout 900 "$LPY" - "$L1" "$FUND_WEI" "${#CUSTOMERS[@]}" <<'PY') || die "funding the Perun accounts on Anvil failed"
import sys
from web3 import Web3
from measure import arbitrum, keys
url, amount, n = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
l1 = Web3(Web3.HTTPProvider(url, request_kwargs={"timeout": 30}))
for i in range(keys.SENSOR, keys.SENSOR + n + 1):
    arbitrum.fund_on_l1(l1, keys.account(keys.FUNDER), keys.account(i).address, amount)
print(f"funded {keys.SENSOR}..{keys.SENSOR + n} on Anvil (perun)")
PY
  (cd "$REPO" && timeout 60 "$LPY" - "$L1" "$DURATION_S" "$WINDOW_MS" "$PRICE_WEI" "$DEPOSIT_WEI" "$FUND_WEI" \
      "$PERUN_OPEN_GAS" "$PERUN_CLOSE_GAS" > "$out/results/budget.json" <<'PY') || die "budget check failed (see results/budget.json)"
import json, sys
from web3 import Web3
url, (dur, win, price, dep, fund, og, cg) = sys.argv[1], map(int, sys.argv[2:])
try:
    base = Web3(Web3.HTTPProvider(url, request_kwargs={"timeout": 10})).eth.get_block("latest")["baseFeePerGas"]
except Exception as e:
    print(json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}))
    sys.exit(2)
n = dur * 1000 // win
need, gas_need = n * price, 10 * (og + cg) * base
ok = need <= dep and gas_need <= fund - dep
print(json.dumps({"stack": "perun", "payments_per_customer": n, "need_wei": need, "deposit_wei": dep,
                  "base_fee_wei": base, "open_close_gas": og + cg, "gas_money_need_wei": gas_need,
                  "gas_money_wei": fund - dep, "ok": ok}))
sys.exit(0 if ok else 1)
PY
}

# perun_sensor_node OUT RD — ports free, contracts and key to bath1, start the sensor node, wait for its
# control API, then check that every customer board reaches it (every customer -> bath1 pair, spec §8).
perun_sensor_node() {
  local out=$1 rd=$2 h s ports allow deadline strict=false persist=false
  [ "${STRICT_POLICY:-1}" != 1 ] || strict=true
  [ "${PERSIST:-1}" != 1 ] || persist=true
  STAGE="perun ports"
  for h in "$SENSOR_BOARD" "${CUSTOMERS[@]}"; do
    ports=":$PERUN_WIRE_PORT"; [ "$h" != "$SENSOR_BOARD" ] || ports="$ports|:$PERUN_CONTROL_PORT"
    s=$(T=20 on "$h" "ss -Hltn | awk '{print \$4}' | grep -E '($ports)\$' || true") \
      || die "$h: could not list listening ports"
    [ -z "$s" ] || die "$h: port(s) already in use: $(tr '\n' ' ' <<< "$s")"
  done
  STAGE="perun sensor node"
  scp_try 30 -q "$out/results/contracts.json" "$SENSOR_BOARD:$rd/contracts.json"
  (cd "$REPO" && "$LPY" -c "from measure import keys; print(keys.account(keys.SENSOR).key.hex())") \
    | timeout 30 ssh "${SSH_OPTS[@]}" "$SENSOR_BOARD" "umask 077; cat > $rd/sensor.key" || die "writing the sensor key on $SENSOR_BOARD failed"
  allow=$(cd "$REPO" && "$LPY" -c "import sys; from measure import keys; print(','.join(keys.account(keys.SENSOR + i).address for i in range(1, int(sys.argv[1]) + 1)))" "${#CUSTOMERS[@]}")
  launch_guarded "$SENSOR_BOARD" "$PERUN_SENSOR_PROC" "cd $rd || exit 1; mkdir -p $rd/ps; setsid nohup $PERUN_BIN_REMOTE -mode uc1-sensor \
    -url $PERUN_CHAIN_WS -chainid $PERUN_CHAIN_ID -contracts $rd/contracts.json -key-file $rd/sensor.key \
    -bind 0.0.0.0:$PERUN_WIRE_PORT -endpoint $SENSOR_IP:$PERUN_WIRE_PORT -control 0.0.0.0:$PERUN_CONTROL_PORT \
    -customers ${#CUSTOMERS[@]} -allow $allow -deposit-wei $DEPOSIT_WEI -challenge $CHALLENGE_S \
    -update-timeout $UPDATE_TIMEOUT_S -strict=$strict -persist=$persist -state $rd/sensor-state \
    -settle-deadline $SETTLE_WAIT_S -out $rd/ps > $rd/perun-sensor.out 2>&1 < /dev/null &"
  deadline=$((SECONDS + READY_WAIT_S))
  until curl -s -m 3 "http://$SENSOR_IP:$PERUN_CONTROL_PORT/v1/manifest" | grep -q '"wire"'; do
    [ "$SECONDS" -lt "$deadline" ] || die "Perun sensor node on $SENSOR_BOARD: no /v1/manifest after ${READY_WAIT_S}s (see logs/$SENSOR_BOARD-perun-sensor.out)"
    T=20 on "$SENSOR_BOARD" "pgrep -f '$PERUN_SENSOR_PROC' >/dev/null" \
      || die "Perun sensor node on $SENSOR_BOARD exited at start (see logs/$SENSOR_BOARD-perun-sensor.out)"
    sleep 2
  done
  STAGE="perun reachability"
  for h in "${CUSTOMERS[@]}"; do
    T=30 on "$h" "for i in 1 2 3; do curl -s -m 3 http://$SENSOR_IP:$PERUN_CONTROL_PORT/v1/manifest | grep -q '\"wire\"' && exit 0; sleep 2; done; exit 1" \
      || die "$h cannot reach the sensor node's control API at $SENSOR_IP:$PERUN_CONTROL_PORT"
  done
  say "perun sensor node up on $SENSOR_BOARD, reachable from ${CUSTOMERS[*]}"
}

# perun_wait_settle RD — after the payment clients completed: until the sensor node has exited, at most
# SETTLE_WAIT_S. Sets PERUN_SRES to "complete", or to why not (the caller fails the run after recording the balance).
PERUN_SRES=""
perun_wait_settle() {
  local rd=$1 deadline=$((SECONDS + SETTLE_WAIT_S)) st
  while :; do
    st=$(T=30 on "$SENSOR_BOARD" "if pgrep -f '$PERUN_SENSOR_PROC' >/dev/null; then echo alive
      elif [ -s $rd/ps/sensor-result.json ]; then python3 -c 'import json,sys; r=json.load(open(sys.argv[1])); print(\"complete\" if r.get(\"complete\") is True else \"incomplete: \" + str(r.get(\"exit_reason\")))' $rd/ps/sensor-result.json
      else echo 'exited without sensor-result.json'; fi" 2>/dev/null || echo unreachable)
    case "$st" in
      alive|unreachable) ;;
      *) PERUN_SRES=$st; say "perun sensor node: $st"; return 0 ;;
    esac
    [ "$SECONDS" -lt "$deadline" ] || { PERUN_SRES="not settled after ${SETTLE_WAIT_S}s ($st)"; return 0; }
    sleep 5
  done
}

# ---- UC2 (USE_CASE=uc2): the six-player game, paid in points (plan Task 13) ---------------------------------
# Command lines as in deploy/uc2-local.sh (Task 12), with the per-board parts filled in. Layout (spec §7.3):
# PLAYERS = players 0..5 (bath1 first), the hub on bath1 beside player 0, bath0 the stack.
HUB_BOARD=$SENSOR_BOARD; HUB_IP=$SENSOR_IP
HUB_CONTROL_PORT=8091                 # not UC1's 8090: a stray UC1 sensor never answers
HUB_WIRE_PORT=9000                    # the hub's Perun wire on bath1
PLAYER_WIRE_PORT=9001                 # every player's sidecar wire (9001: player 0 shares bath1 with the hub's 9000)
GAME_PORT=9100                        # the game mesh on every player
REFERENCE_SHA="$REPO/tank-arena/reference/uc2-seed42.jsonl.sha256"   # Task 14; copied into the run (ruling P4)

# uc2_reference — the reference log's SHA-256 (first word of REFERENCE_SHA, 64 hex digits) on stdout; refuses
# (exit 1, with why) when the file is missing or malformed: a UC2 run must not start without it.
uc2_reference() {
  local v="" got=""
  [ -s "$REFERENCE_SHA" ] && v=$(awk 'NR == 1 {print tolower($1)}' "$REFERENCE_SHA")
  if [[ ! $v =~ ^[0-9a-f]{64}$ ]]; then
    [ -z "$v" ] || got="it holds \"$v\", not a SHA-256; "
    echo "refusing a UC2 run: no reference log hash in $REFERENCE_SHA (${got}Task 14 creates it from the" \
      "reference log generated on bath2; commit it and run deploy/cluster sync first)" >&2
    return 1
  fi
  echo "$v"
}

# uc2_params_check — the experiment file's UC2 keys are complete and consistent (before any run folder exists).
uc2_params_check() {
  local k h seen=" "
  for k in STACK N_PLAYERS TICKRATE GAME_TICKS GAME_SEED START_POINTS MAX_QUEUE DRAIN_S MAX_IN_FLIGHT FUND_WEI DEPOSIT_WEI; do
    [ -n "${!k:-}" ] || die "uc2: $k is not set in the experiment file"
  done
  [ "$((GAME_TICKS % TICKRATE))" -eq 0 ] || die "uc2: GAME_TICKS=$GAME_TICKS is not a whole number of seconds at TICKRATE=$TICKRATE"
  [ "${#PLAYERS[@]}" -eq "$N_PLAYERS" ] || die "uc2: PLAYERS has ${#PLAYERS[@]} boards, N_PLAYERS=$N_PLAYERS"
  [ "${PLAYERS[0]}" = "$HUB_BOARD" ] || die "uc2: player 0 must be $HUB_BOARD (the host, beside the hub), not ${PLAYERS[0]}"
  for h in "${PLAYERS[@]}"; do
    case " ${BOARDS[*]:1} " in *" $h "*) ;; *) die "uc2: player $h is not an active board (bath0 or idle or unknown)" ;; esac
    case $seen in *" $h "*) die "uc2: $h is in PLAYERS twice" ;; esac
    seen="$seen$h "
  done
  if [ "$STACK" = perun ]; then
    for k in UPDATE_TIMEOUT_S CHALLENGE_S PERSIST YIELD_TIMEOUT_MS MAX_COLLISION_RETRIES; do
      [ -n "${!k:-}" ] || die "uc2: $k is not set in the experiment file (perun)"
    done
  fi
}

# uc2_code_check OUT — every active board runs the workstation's measure/ code and game code (R8).
uc2_code_check() {
  local out=$1 want gwant h s
  want=$(code_hash "$REPO"); echo "$want" > "$out/code-hash.txt"
  gwant=$(game_hash "$REPO") || die "game hash of $REPO/tank-arena failed"
  [ -n "$gwant" ] || die "game hash of $REPO/tank-arena is empty"
  echo "$gwant" > "$out/game-hash.txt"
  for h in "${BOARDS[@]:1}"; do
    s=$(T=30 on "$h" "[ -x ~/venv/bin/python ] && cd ~/measure-code && find measure -name '*.py' -not -path '*/__pycache__/*' | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-16" || true)
    [ "$s" = "$want" ] || die "$h: code ${s:-missing} differs from the workstation ($want); run deploy/cluster sync"
    s=$(T=30 on "$h" "cd ~/measure-code && $GAME_HASH_CMD" || true)
    [ "$s" = "$gwant" ] || die "$h: game code ${s:-missing} differs from the workstation ($gwant); run deploy/cluster sync"
  done
}

# uc2_ports — nothing listens yet on the ports the match uses (game mesh; Perun: wire on every player, the
# hub's wire and control on bath1).
uc2_ports() {
  local h ports s
  for h in "${PLAYERS[@]}"; do
    ports=":$GAME_PORT"
    [ "$STACK" != perun ] || ports="$ports|:$PLAYER_WIRE_PORT"
    [ "$STACK" != perun ] || [ "$h" != "$HUB_BOARD" ] || ports="$ports|:$HUB_WIRE_PORT|:$HUB_CONTROL_PORT"
    s=$(T=20 on "$h" "ss -Hltn | awk '{print \$4}' | grep -E '($ports)\$' || true") || die "$h: could not list listening ports"
    [ -z "$s" ] || die "$h: port(s) already in use: $(tr '\n' ' ' <<< "$s")"
  done
}

# uc2_bound OUT GAME_S — results/bound.json from the rules (python -m arena.bound, never the spec text);
# `ok` must be true and start_points must be START_POINTS.
uc2_bound() {
  local out=$1 game_s=$2
  (cd "$REPO/tank-arena" && timeout 300 "$LPY" -m arena.bound --json --players "$N_PLAYERS" --tickrate "$TICKRATE" \
      --duration "$game_s") > "$out/results/bound.json" || die "arena.bound failed"
  "$LPY" - "$out/results/bound.json" "$START_POINTS" <<'PY' || die "bound check failed (see results/bound.json)"
