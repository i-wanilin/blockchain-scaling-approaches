#!/usr/bin/env bash
# cluster — drive the Pi cluster from the workstation (cluster spec §5).
# Usage: deploy/cluster sync|up arbitrum|zksync|perun|down|status|preflight|idle-temps|run <experiment> [--reps N]
#
# Every wait has a deadline. A failed repetition writes RUN_FAILED into its run
# folder, still collects what exists, still brings the cluster down, and stops
# (no further repetitions on a broken state).
set -euo pipefail
