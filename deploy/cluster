# Per-stack endpoints, set by stack_endpoints (in `up` and after the experiment env is sourced):
# L1 HTTP, L2 WebSocket (payments), L2 HTTP (never derived from the WS URL), L2 WS port.
L1=""; L2_WS=""; L2_HTTP=""; L2_WS_PORT=""
stack_endpoints() {
  case "$1" in
    arbitrum) L1=http://$STACK_IP:8545; L2_WS=ws://$STACK_IP:8548; L2_HTTP=http://$STACK_IP:8547; L2_WS_PORT=8548 ;;
    zksync)   L1=http://$STACK_IP:8945; L2_WS=ws://$STACK_IP:3051; L2_HTTP=http://$STACK_IP:3050; L2_WS_PORT=3051 ;;
    # Perun has no L2: payments are off-chain channel updates. Anvil is its only chain (HTTP and WS on 8545).
    perun)    L1=http://$STACK_IP:8545; L2_WS=""; L2_HTTP=""; L2_WS_PORT="" ;;
    *) die "unknown stack '$1'" ;;
  esac
}
# zkSync on bath0 (facts file archive/bench-workstation/results/zksync-uc1-facts-2026-10-01.md, F1-F6).
