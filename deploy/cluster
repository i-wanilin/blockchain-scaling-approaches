          f"throttled={f.get('throttled')} off={'%.3fms' % off if isinstance(off, (int, float)) else off} "
          f"src={f.get('chrony_source')} temp={f.get('temp_c')}C disk={f.get('disk_free_gb')}GB "
          f"netem={f.get('netem')} docker={f.get('docker_up')} anvil={f.get('anvil_up')}")
