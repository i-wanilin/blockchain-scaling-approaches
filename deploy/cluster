cmd_preflight() {
  local d; d=$(mktemp -d); gather_facts "$d"
  local rc=0; (cd "$REPO" && "$LPY" -m measure.preflight "$d") || rc=$?
  rm -rf "$d"; [ "$rc" -eq 0 ] && echo "pre-flight ok"; return "$rc"
