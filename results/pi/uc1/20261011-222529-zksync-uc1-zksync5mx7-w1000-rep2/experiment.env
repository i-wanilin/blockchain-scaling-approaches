USE_CASE=uc1
STACK=zksync
WINDOW_MS=1000
DURATION_S=900
PRICE_WEI=1000000000000
DEPOSIT_WEI=1000000000000000000
FUND_WEI=2000000000000000000
# cluster spec §7.3: zkSync mainnet's per-account limit
MAX_IN_FLIGHT=20
MAX_QUEUE=10000
# Q3 a: the same as Arbitrum
DRAIN_S=60
# > DURATION_S + DRAIN_S: no slot is freed before an outcome
RECEIPT_TIMEOUT_S=1200
# Close waits behind the backlog (Q3)
CLOSE_TIMEOUT_S=1800
# Q2 a
ZK_COMMIT_DEADLINE_MS=20000
# Q4 a: 2700 (owner, 2026-10-01): the 60 s smoke run peaked at ~60 C and cooled in ~9 min, which says nothing about cooling from ~84 C after 15 min; a cap, not a wait
COOL_MAX_S=2700
# Q5 a: set to bath0 only if the smoke run shows the sticky bits
THERMAL_STICKY_OK=
# owner decision 2026-10-01: Wi-Fi stalls of several seconds dropped all six
# customers twice (receive lag 0.01 s -> 16-24 s at the same instant); tolerate
# stalls up to 30 s so a stall shows up as latency, not a lost run.
# 3600 frames = 30 s x 120 rows/s (default queue_max is 240 frames = 2 s).
SENSOR_QUEUE_MAX=3600
# a stalled socket's write() would otherwise hit the default 5 s write_timeout
# and drop the customer before its queue backlog ever reaches 30 s; raise it to
# match.
SENSOR_WRITE_TIMEOUT_S=30
# FINAL UC1 board set (owner, 2026-10-11): bath3 is dead (board power fault), bath7 takes its place as customer 5;
# the same boards as the UC2 series. bath3 idle (not synced, not checked).
CUSTOMERS=(bath2 bath4 bath5 bath6 bath7)
IDLE_BOARDS="bath3"
EXPECTED_CUSTOMERS=5
# MIXED WI-FI series (owner, 2026-10-05): bath1 (sensor) and bath2 on the router's 5 GHz radio, every other board
# on 2.4 GHz (bath0's 5 GHz link measured 13 Mbit/s); spec §9 U4. Pre-flight checks each board's radio.
WIFI_5GHZ_BOARDS="bath1 bath2"
