# Probe (2026-11-02, not a final series): uc2-perun with every player beginning its Open at one
# agreed time (OPEN_AT_DELAY_S after the launch, from bath1's clock), so the Open does not include
# the launcher's ssh spacing. Everything else as uc2-perun.env.
USE_CASE=uc2
N_PLAYERS=6
TICKRATE=20
GAME_TICKS=1200
GAME_SEED=42
START_POINTS=10000
PLAYERS=(bath1 bath2 bath7 bath4 bath5 bath6)
IDLE_BOARDS="bath3"
WIFI_5GHZ_BOARDS="bath1 bath2"
MAX_QUEUE=10000
DRAIN_S=60
FUND_WEI=2000000000000000000
DEPOSIT_WEI=1000000000000000000
STACK=perun
MAX_IN_FLIGHT=64
UPDATE_TIMEOUT_S=10
CHALLENGE_S=10
PERSIST=1
STRICT_POLICY=1
YIELD_TIMEOUT_MS=200
MAX_COLLISION_RETRIES=10
READY_WAIT_S=900
COMPLETE_EXTRA_S=960
OPEN_AT_DELAY_S=60
