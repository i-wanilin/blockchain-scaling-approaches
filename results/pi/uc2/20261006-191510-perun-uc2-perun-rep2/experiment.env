# UC2 on perun: the frozen six-player match (deploy/cluster run uc2-perun --reps 3)
USE_CASE=uc2
# the frozen match (spec §7.3 Run parameters, plan Global Constraints): 6 players, 20 Hz, 1 200 ticks (60 s),
# seed 42, mesh; 10 000 points per player (the bound is checked by every run's setup, arena.bound)
N_PLAYERS=6
TICKRATE=20
GAME_TICKS=1200
GAME_SEED=42
START_POINTS=10000
# player 0 = bath1 (also the time server and, on Perun, the hub), then bath2, bath7, bath4, bath5, bath6
PLAYERS=(bath1 bath2 bath7 bath4 bath5 bath6)
# R9: bath3 takes no part in UC2: no code check, no facts, no recorder; pre-flight expects the other 7
IDLE_BOARDS="bath3"
# MIXED WI-FI (owner, 2026-10-05/06): bath1 and bath2 on the router's 5 GHz radio, every other board on
# 2.4 GHz; pre-flight checks each board's radio
WIFI_5GHZ_BOARDS="bath1 bath2"
# the payment client's queue and drain, as UC1
MAX_QUEUE=10000
DRAIN_S=60
# L1 funds per account (untimed setup); DEPOSIT_WEI = the ETH each player bridges as Open on the rollups
# (Perun: the player's channel holds its points, the payment client gets --deposit-wei 0)
FUND_WEI=2000000000000000000
DEPOSIT_WEI=1000000000000000000
STACK=perun
# at most 64 payments outstanding in the uc2-player sidecar
MAX_IN_FLIGHT=64
# channel update timeout (s): an update not answered in time is unresolved and breaks the channel (no retries)
UPDATE_TIMEOUT_S=10
# channel challenge duration (s), every ledger and virtual channel
CHALLENGE_S=10
# channel state persisted (LevelDB) on the hub and every player
PERSIST=1
# the hub's payment policy on ledger channels (R7: a player may only lower its own balance)
STRICT_POLICY=1
# head-on hits on one virtual channel: yield 200 ms, at most 10 collision retries (owner, Checkpoint 2, 2026-10-06:
# 200 ms is ~7x the Pis' ~30 ms update round trip and cuts Perun's collision tail; a normal update slower than
# the yield desyncs the channel, which is detected and fails the run, never silent)
YIELD_TIMEOUT_MS=200
MAX_COLLISION_RETRIES=10
# Open = init (<= 130 s) + the ledger and virtual Opens (<= 600 s, measure/perun_uc2.py), so the wait for
# every payment client's `ready` is 900 s; Close may take 900 s (perun_uc2.CLOSE_TIMEOUT_S), so the wait
# for `complete` after the drain is 960 s
READY_WAIT_S=900
COMPLETE_EXTRA_S=960
